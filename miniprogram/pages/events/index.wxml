<view class="home theme-{{theme}}" style="{{themeVars}}">
  <!-- 顶栏：汉堡 + 居中字标。状态栏用 padding-top 躲开，不画假时间和胶囊 -->
  <view class="topbar {{pageHidden ? 'topbar--parked' : ''}}" style="padding-top:{{statusBarHeight}}px;background:{{headerGradient}}">
    <view class="topbar__row">
      <view class="hamburger" bindtap="onOpenDrawer" hover-class="hamburger--pressed" hover-stay-time="60">
        <view class="hamburger__line"></view>
        <view class="hamburger__line"></view>
        <view class="hamburger__line"></view>
      </view>
      <view class="wordmark">
        <text class="wordmark__title">LTJIMMY赛事</text>
        <view class="wordmark__speed">
          <view class="wordmark__dash wordmark__dash--1"></view>
          <view class="wordmark__dash wordmark__dash--2"></view>
          <view class="wordmark__dash wordmark__dash--3"></view>
        </view>
      </view>
    </view>
  </view>
  <!-- 顶栏 fixed 不占高度，用同等高的空块把轮播顶下去 -->
  <view class="topbar-spacer" style="height: calc({{statusBarHeight}}px + 88rpx)"></view>

  <!-- 轮播 320rpx。V5 直边，标题叠在图上，不要白浪 -->
  <view class="hero">
    <swiper
      class="hero__swiper"
      circular
      autoplay
      interval="5000"
      duration="400"
      bindchange="onSwiperChange"
    >
      <swiper-item class="hero__item" wx:for="{{banners}}" wx:key="id">
        <view class="hero__slide" data-index="{{index}}" bindtap="onBannerTap">
          <image class="hero__image" src="{{item.image}}" mode="aspectFill" />
          <view class="hero__scrim"></view>
          <view class="hero__copy">
            <view class="hero__title">{{item.title}}</view>
            <view class="hero__sub">{{item.subtitle}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="hero__dots">
      <view
        wx:for="{{banners}}"
        wx:key="id"
        class="hero__dot {{index === currentBanner ? 'hero__dot--on' : ''}}"
      ></view>
    </view>
  </view>

  <view class="sheet">
    <view class="hot">
      <view class="hot__head">
        <view class="hot-mark">
          <view class="hot-mark__dot hot-mark__dot--tl"></view>
          <text class="hot-mark__title">热门赛事</text>
          <view class="hot-mark__dot hot-mark__dot--br"></view>
          <view class="hot-mark__speed">
            <view class="hot-mark__bar" style="width:14rpx"></view>
            <view class="hot-mark__bar" style="width:26rpx"></view>
            <view class="hot-mark__bar" style="width:18rpx"></view>
            <view class="hot-mark__bar" style="width:10rpx"></view>
          </view>
        </view>
      </view>
      <scroll-view class="hot__scroller" scroll-x show-scrollbar="{{false}}">
        <view
          class="hot-card"
          wx:for="{{hotEvents}}"
          wx:key="id"
          data-id="{{item.eventId}}"
          bindtap="onHotTap"
        >
          <view class="hot-card__photo">
            <image class="hot-card__image" src="{{item.image}}" mode="aspectFill" />
            <view class="hot-card__rank">{{item.rank}}</view>
          </view>
          <view class="hot-card__title">{{item.title}}</view>
          <view class="hot-card__sub">{{item.subtitle}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="search">
      <view class="search__city" bindtap="onCityTap">
        <view class="search__pin"></view>
        <text class="search__city-name">{{cityLabel}}</text>
        <text class="search__caret">▾</text>
      </view>
      <view class="search__field">
        <input
          class="search__input"
          value="{{keyword}}"
          placeholder="室内"
          placeholder-class="search__placeholder"
          confirm-type="search"
          bindinput="onKeywordInput"
        />
        <view class="search__icon"></view>
      </view>
    </view>

    <filter-tabs
      tabs="{{filters}}"
      active="{{activeFilter}}"
      active-color="{{accent}}"
      active-text-color="{{accentText}}"
      variant="capsule"
      bind:change="onFilterChange"
    />

    <view class="feed">
      <view class="list-filters">
        <view class="list-filters__row">
          <view
            class="list-filters__item {{item.on ? 'is-on' : ''}}"
            wx:for="{{listFilters}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onListFilterTap"
          >
            <text>{{item.label}}</text>
            <text class="list-filters__caret">▾</text>
          </view>
        </view>
        <view class="list-filters__reset" bindtap="onResetListFilters">↺</view>
      </view>

      <event-card
        class="feed__card"
        wx:for="{{events}}"
        wx:key="id"
        event="{{item}}"
        bind:cardtap="onEventTap"
        bind:venuetap="onVenueTap"
      />
      <view class="feed__empty" wx:if="{{events.length === 0}}">{{emptyHint}}</view>
    </view>
  </view>

  <view class="tabbar-spacer"></view>

  <!-- 侧栏：七个宫格入口搬到这里。底部只留「收起」，换背景在「我的」里做，不要再做深色模式 -->
  <view
    class="drawer-mask {{drawerOpen ? 'is-open' : ''}}"
    bindtap="onCloseDrawer"
    catchtouchmove="onPreventMove"
  ></view>
  <view class="drawer {{drawerOpen ? 'is-open' : ''}}" catchtouchmove="onPreventMove">
    <view class="drawer__list">
      <view
        class="drawer__item"
        wx:for="{{features}}"
        wx:key="key"
        data-key="{{item.key}}"
        data-path="{{item.path}}"
        bindtap="onFeatureTap"
      >
        <image class="drawer__icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="drawer__label">{{item.label}}</text>
      </view>
    </view>
    <view class="drawer__line"></view>
    <view class="drawer__foot" bindtap="onCloseDrawer" hover-class="drawer__foot--pressed" hover-stay-time="80">
      <text class="drawer__foot-icon">‹‹</text>
      <text class="drawer__foot-text">收起</text>
    </view>
  </view>

  <!--
    项目 / 区域 / 日期 / 更多 四个弹层是同一页状态
    （Figma 194:346 / 204:199 / 204:322 / 204:237），不要做成四个页面。
  -->
  <view
    class="filter-mask {{filterSheet ? 'is-open' : ''}}"
    bindtap="onCloseFilterSheet"
    catchtouchmove="onPreventMove"
  ></view>

  <view
    class="fsheet fsheet--cat {{filterSheet === 'category' ? 'is-open' : ''}}"
    catchtouchmove="onPreventMove"
  >
    <view class="fsheet__handle"></view>
    <picker-view
      class="fsheet-picker"
      value="{{draftCatValue}}"
      indicator-class="fsheet-picker__window"
      bindchange="onDraftCatChange"
    >
      <picker-view-column>
        <view class="fsheet-picker__item" wx:for="{{categoryLeft}}" wx:key="*this">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view class="fsheet-picker__item" wx:for="{{draftCatRight}}" wx:key="*this">{{item}}</view>
      </picker-view-column>
    </picker-view>
    <view class="fsheet__actions">
      <view class="fsheet__btn fsheet__btn--ghost" bindtap="onCloseFilterSheet">取消</view>
      <view class="fsheet__btn fsheet__btn--fill" style="background:{{accent}};color:{{accentText}}" bindtap="onConfirmCategory">确定</view>
    </view>
  </view>

  <view
    class="fsheet fsheet--area {{filterSheet === 'area' ? 'is-open' : ''}}"
    catchtouchmove="onPreventMove"
  >
    <view class="fsheet__handle"></view>
    <scroll-view class="fsheet-list" scroll-y show-scrollbar="{{false}}">
      <view
        class="fsheet-row {{item === listFilterValues.area ? 'is-on' : ''}}"
        wx:for="{{areaOptions}}"
        wx:key="*this"
        data-name="{{item}}"
        bindtap="onSelectArea"
      >
        <text class="fsheet-row__name">{{item}}</text>
        <text class="fsheet-row__check" wx:if="{{item === listFilterValues.area}}">✓</text>
      </view>
    </scroll-view>
  </view>

  <view
    class="fsheet fsheet--date {{filterSheet === 'date' ? 'is-open' : ''}}"
    catchtouchmove="onPreventMove"
  >
    <view class="date-head">
      <view class="date-head__title">{{calTitle}}</view>
      <view class="date-head__hint">可多选</view>
      <view class="date-head__nav">
        <view class="date-head__arrow" data-delta="-1" bindtap="onShiftMonth">‹</view>
        <view class="date-head__arrow" data-delta="1" bindtap="onShiftMonth">›</view>
      </view>
    </view>
    <view class="date-weekdays">
      <view class="date-weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="date-grid">
      <view class="date-week" wx:for="{{calWeeks}}" wx:for-index="weekIndex" wx:key="weekIndex">
        <view class="date-cell" wx:for="{{item}}" wx:for-item="cell" wx:key="key">
          <view
            wx:if="{{cell.inMonth}}"
            class="date-cell__day {{cell.selected ? 'is-on' : ''}}"
            style="{{cell.selected ? 'background:' + accent + ';color:' + accentText : ''}}"
            data-key="{{cell.key}}"
            bindtap="onDraftDateTap"
          >{{cell.day}}</view>
        </view>
      </view>
    </view>
    <view class="date-foot">
      <view class="date-foot__sum">
        <text class="date-foot__label">已选择</text>
        <text class="date-foot__value" style="color:{{accent}}">{{dateSummary}}</text>
      </view>
      <view class="date-foot__btns">
        <view class="date-reset" style="border-color:{{accent}};color:{{accent}}" bindtap="onResetDates">重置</view>
        <view class="date-ok" style="background:{{accent}};color:{{accentText}}" bindtap="onConfirmDates">确定</view>
      </view>
    </view>
  </view>

  <view
    class="fsheet fsheet--more {{filterSheet === 'more' ? 'is-open' : ''}}"
    catchtouchmove="onPreventMove"
  >
    <scroll-view class="fsheet-more" scroll-y show-scrollbar="{{false}}">
      <view class="more-block">
        <view class="more-title">场地类型</view>
        <view class="more-chips" wx:for="{{courtTypeRows}}" wx:for-item="row" wx:key="*this">
          <view
            class="more-chip {{chip === draftMore.court ? 'is-on' : ''}}"
            style="{{chip === draftMore.court ? 'background:' + accent + ';color:' + accentText : ''}}"
            wx:for="{{row}}"
            wx:for-item="chip"
            wx:key="*this"
            data-field="court"
            data-name="{{chip}}"
            bindtap="onSelectMoreChip"
          >{{chip}}</view>
        </view>
      </view>

      <view class="more-block">
        <view class="more-range-head">
          <view class="more-title">等级范围</view>
          <view class="more-check" bindtap="onToggleEligible">
            <view class="more-check__box {{draftMore.eligible ? 'is-on' : ''}}" style="{{draftMore.eligible ? 'background:' + accent + ';border-color:' + accent : 'border-color:' + accent}}">
              <text wx:if="{{draftMore.eligible}}" class="more-check__tick" style="color:{{accentText}}">✓</text>
            </view>
            <text class="more-check__label" style="color:{{accent}}">仅展示我可报名的</text>
          </view>
        </view>
        <view class="more-stepper-row">
          <view class="more-stepper">
            <view class="more-stepper__btn" data-field="personalMin" data-delta="-1" bindtap="onStepLevel" style="color:{{accent}}">−</view>
            <view class="more-stepper__value">{{levelLabels[draftMore.personalMin]}}</view>
            <view class="more-stepper__btn" data-field="personalMin" data-delta="1" bindtap="onStepLevel" style="color:{{accent}}">+</view>
          </view>
          <view class="more-stepper-mid">≤ 个人等级 ≤</view>
          <view class="more-stepper">
            <view class="more-stepper__btn" data-field="personalMax" data-delta="-1" bindtap="onStepLevel" style="color:{{accent}}">−</view>
            <view class="more-stepper__value">{{levelLabels[draftMore.personalMax]}}</view>
            <view class="more-stepper__btn" data-field="personalMax" data-delta="1" bindtap="onStepLevel" style="color:{{accent}}">+</view>
          </view>
        </view>
        <view class="more-stepper-row">
          <view class="more-stepper">
            <view class="more-stepper__btn" data-field="teamMin" data-delta="-1" bindtap="onStepLevel" style="color:{{accent}}">−</view>
            <view class="more-stepper__value">{{levelLabels[draftMore.teamMin]}}</view>
            <view class="more-stepper__btn" data-field="teamMin" data-delta="1" bindtap="onStepLevel" style="color:{{accent}}">+</view>
          </view>
          <view class="more-stepper-mid">≤ 组队等级 ≤</view>
          <view class="more-stepper">
            <view class="more-stepper__btn" data-field="teamMax" data-delta="-1" bindtap="onStepLevel" style="color:{{accent}}">−</view>
            <view class="more-stepper__value">{{levelLabels[draftMore.teamMax]}}</view>
            <view class="more-stepper__btn" data-field="teamMax" data-delta="1" bindtap="onStepLevel" style="color:{{accent}}">+</view>
          </view>
        </view>
      </view>

      <view class="more-block">
        <view class="more-title">开赛时段</view>
        <view class="more-chips" wx:for="{{slotRows}}" wx:for-item="row" wx:key="*this">
          <view
            class="more-chip {{chip === draftMore.slot ? 'is-on' : ''}}"
            style="{{chip === draftMore.slot ? 'background:' + accent + ';color:' + accentText : ''}}"
            wx:for="{{row}}"
            wx:for-item="chip"
            wx:key="*this"
            data-field="slot"
            data-name="{{chip}}"
            bindtap="onSelectMoreChip"
          >{{chip}}</view>
        </view>
      </view>

      <view class="more-block">
        <view class="more-title">等级段</view>
        <view class="more-chips" wx:for="{{gradeBandRows}}" wx:for-item="row" wx:key="*this">
          <view
            class="more-chip {{chip === draftMore.gradeBand ? 'is-on' : ''}}"
            style="{{chip === draftMore.gradeBand ? 'background:' + accent + ';color:' + accentText : ''}}"
            wx:for="{{row}}"
            wx:for-item="chip"
            wx:key="*this"
            data-field="gradeBand"
            data-name="{{chip}}"
            bindtap="onSelectMoreChip"
          >{{chip}}</view>
        </view>
      </view>

      <view class="fsheet__actions fsheet__actions--more">
        <view class="fsheet__btn fsheet__btn--ghost" bindtap="onResetMore">重置</view>
        <view class="fsheet__btn fsheet__btn--fill" style="background:{{accent}};color:{{accentText}}" bindtap="onConfirmMore">确定</view>
      </view>
    </scroll-view>
  </view>
</view>
