/**
 * ============================================================================
 * 赛事相册页样式
 * ============================================================================
 * 数值来自 Figma node 23:272 及其子节点。
 * 旧绿头、相机、椭圆白浪已经删掉，occupy 吸顶栏。筛选选中走主题强调色。
 *
 * 【两种版式用修饰类切换】
 * 相册分两种排法，差异不只是图片尺寸，连内外边距、标题字号、行间距都不同：
 *
 *              赛程表分组            赛事分组
 *   图片        293×184 两张         190×126 三张
 *   图片圆角    16rpx                14rpx
 *   图片间距    20rpx                18rpx
 *   标题字号    25rpx                23rpx
 *   容器内边距  26/72/18             24/72/14
 *   分隔线      无                   有
 *
 * 实现方式是给赛程表分组加一个 .section--bracket 修饰类，用它覆盖默认值，
 * 这样只写一套模板就能出两种版式。哪个分组用哪种由 mock/gallery.ts 里
 * 每项的 layout 字段决定（'bracket' 或 'photo'）。
 */

.gallery {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: var(--page-bg);
}

.kicker {
  margin-top: 8rpx;
  padding: 0 54rpx 4rpx;
  font-size: 20rpx;
  line-height: 34rpx;
  color: #424740;
}

/* ---------- 分类筛选 ---------- */

.filters {
  display: flex;
  align-items: center;
  gap: 18rpx;
  height: 92rpx;
  padding: 0 54rpx;
}

.filters__chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 24rpx;
  border: 2rpx solid #cfd2c6;
  border-radius: 26rpx;
  background: #ffffff;
  font-size: 19rpx;
  font-weight: 600;
  color: #141a12;
}

.filters__chip.is-active {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--accent-text);
  box-shadow: 0 4rpx 10rpx rgba(20, 24, 16, 0.16);
}

/* ---------- 分组 ---------- */

.section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 72rpx 14rpx;
}

/* 赛程表分组的内外间距与图片尺寸都与赛事分组不同（node 23:292） */
.section--bracket {
  gap: 12rpx;
  padding: 26rpx 72rpx 18rpx;
}

.section__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 42rpx;
}

.section--bracket .section__heading {
  height: 44rpx;
}

.section__title {
  display: flex;
  align-items: center;
  gap: 4rpx;
  overflow: hidden;
}

.section__title-part {
  font-size: 23rpx;
  font-weight: 700;
  color: #0f140d;
  white-space: nowrap;
}

.section--bracket .section__title-part {
  font-size: 25rpx;
}

.section__title-part--brand {
  color: var(--accent);
}

.section__more {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6b7066;
}

.section__subtitle {
  height: 28rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #6b7066;
}

.section__photos {
  display: flex;
  gap: 18rpx;
}

.section--bracket .section__photos {
  gap: 20rpx;
}

.section__photo {
  flex-shrink: 0;
  width: 190rpx;
  height: 126rpx;
  border-radius: 14rpx;
}

.section--bracket .section__photo {
  width: 293rpx;
  height: 184rpx;
  border-radius: 16rpx;
}

.section__count {
  height: 28rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: #6b7066;
}

.section--bracket .section__count {
  height: 30rpx;
  line-height: 30rpx;
}

.section__divider {
  height: 1rpx;
  background: #dbded4;
}

.feed__empty {
  padding: 80rpx 32rpx 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #787e6c;
}
