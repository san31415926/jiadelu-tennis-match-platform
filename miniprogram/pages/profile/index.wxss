/**
 * ============================================================================
 * 我的页样式 —— 视觉刷新草稿 V5
 * ============================================================================
 * 数值来自 Figma node 302:103（薄荷资料头）和 401:359（更换背景抽屉）。
 * 设计稿 1px = 1rpx。
 *
 * 【这一页的块】
 *   1. 薄荷霜化头图：封面模糊 + 半透明色罩，头像 120，四列数据
 *   2. VIP 条走主题强调色 --accent，不要写死青绿
 *   3. 战力图白卡 + canvas 雷达
 *   4. 我的生涯两列 + 参赛记录通栏
 *   5. 更多服务三列
 *   6. 更换背景底部抽屉
 *
 * 旧绿波浪头、金圈领奖台、七项菜单列表已经删掉。
 * 换主题只改 .profile--* 的霜化色。没有封面时走 .hero--plain，只显示纯色。
 * 相册打球照走 .hero--album：只轻轻一糊，名字和「更换背景」中间的空位把图漏出来。
 */

.profile {
  min-height: 100vh;
  background: var(--page-bg);
}

.profile--mint {
  --frost: rgba(184, 237, 220, 0.82);
  --fade-end: var(--page-bg);
  --page-tint: #b8eddc;
}

.profile--lime {
  --frost: rgba(212, 243, 74, 0.72);
  --fade-end: var(--page-bg);
  --page-tint: #d4f34a;
}

.profile--gold {
  --frost: rgba(226, 177, 90, 0.55);
  --fade-end: var(--page-bg);
  --page-tint: #e2b15a;
}

.profile--sky {
  --frost: rgba(110, 180, 224, 0.58);
  --fade-end: var(--page-bg);
  --page-tint: #6eb4e0;
}

.profile--dusk {
  --frost: rgba(224, 138, 170, 0.5);
  --fade-end: var(--page-bg);
  --page-tint: #e08aaa;
}

.profile--photo {
  --frost: rgba(184, 237, 220, 0.28);
  --fade-end: var(--page-bg);
  --page-tint: #b8eddc;
}

.hero {
  position: relative;
  overflow: hidden;
  background: var(--page-tint);
  padding-top: env(safe-area-inset-top);
}

/**
 * 封面铺满头图这一块，高度跟着内容走，不要写死 1120rpx。
 * 写死会把正方形头像放大到整屏高，中间空位只剩眼睛和发带。
 * 相册照再走 .hero--album，糊得更轻。
 */
.hero__cover-clip {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.hero__cover {
  width: 100%;
  height: 100%;
  filter: blur(12px);
  /* 只为糊边留一丁点，再大就会把人放大到只剩五官 */
  transform: scale(1.04);
}

.hero__frost {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  /* 左右罩住名字和「更换背景」，中间空位把封面漏出来 */
  background: linear-gradient(
    90deg,
    var(--frost) 0%,
    var(--frost) 22%,
    rgba(255, 255, 255, 0.12) 38%,
    rgba(255, 255, 255, 0.12) 70%,
    var(--frost) 100%
  );
}

/**
 * 自己选的打球照：只虚一点点，还能认出人。
 * 霜化改成横向渐变——头像/名字左侧、更换背景右侧略罩，
 * 中间那一大块空位几乎不罩，照片从这里漏出来。
 */
.hero--album .hero__cover {
  filter: blur(6px);
  transform: scale(1.03);
}

.hero--album .hero__frost {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.55) 0%,
    rgba(255, 255, 255, 0.28) 22%,
    rgba(255, 255, 255, 0.04) 36%,
    rgba(255, 255, 255, 0.04) 72%,
    rgba(255, 255, 255, 0.36) 100%
  );
}

/* 没有封面图时不要横向漏空，否则纯色中间会发白 */
.hero--plain .hero__frost {
  background: transparent;
}

.hero__fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(180deg, transparent 0%, var(--fade-end) 100%);
}

.hero__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  padding: 28rpx 32rpx 20rpx;
}

.identity {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.identity__avatar {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #ffffff;
}

/**
 * 微信里 image 自己写 border-radius 经常裁不圆。
 * 外圈负责圆形，图用 aspectFit 完整放进圆里，避免上传后脑袋被切掉。
 * 竖图左右会留白、横图上下会留白，这是「看全图」的代价。
 */
.identity__avatar-img {
  display: block;
  width: 100%;
  height: 100%;
}

.identity__info {
  flex: 1;
  min-width: 0;
}

.identity__name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 46rpx;
  color: #000000;
}

.identity__name--guest {
  text-decoration: underline;
}

.identity__uid {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: #111111;
}

.identity__cover-btn {
  width: 120rpx;
  height: 40rpx;
  line-height: 37rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 500;
  color: #1f1f1f;
  border: 1.5rpx solid #ffffff;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.32);
}

.identity__cover-btn--pressed {
  opacity: 0.7;
}

.bio {
  font-size: 24rpx;
  line-height: 31rpx;
  color: #111111;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 22rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: #1a1a1a;
}

.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat__num {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 46rpx;
  color: #000000;
}

.stat__label {
  font-size: 20rpx;
  line-height: 26rpx;
  color: #111111;
}

.vip {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin: 0 24rpx 12rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  border-radius: 32rpx;
  /* 底色和字色由内联 accent / accentText 写入，这里只是默认薄荷 */
  background: var(--accent);
  color: var(--accent-text);
}

.vip--pressed {
  opacity: 0.88;
}

.vip__crown {
  flex-shrink: 0;
  width: 48rpx;
  height: 40rpx;
}

.vip__copy {
  flex: 1;
  min-width: 0;
}

.vip__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: inherit;
}

.vip__sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  color: inherit;
  opacity: 0.72;
}

.vip__cta {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background: #141414;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: #ffffff;
}

.body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 16rpx 32rpx 32rpx;
}

.block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.block__head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.block__title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 39rpx;
  color: #1c1f21;
}

.block__chip {
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(131, 212, 20, 0.18);
  font-size: 22rpx;
  font-weight: 500;
  color: #386b14;
}

.radar-card {
  padding: 12rpx 12rpx 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.radar {
  position: relative;
  height: 380rpx;
}

.radar__canvas {
  width: 100%;
  height: 380rpx;
  /* 原生 canvas 不吃 z-index。抽屉打开时 wxml 里 wx:if 卸掉它 */
}

.radar-label {
  position: absolute;
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  font-weight: 500;
  color: #1c1f21;
  background: #ffffff;
  padding: 0 4rpx;
}

.radar-label__num {
  font-size: 20rpx;
  font-weight: 700;
  color: #47850f;
}

.radar-label--n {
  left: 50%;
  top: 8rpx;
  align-items: center;
  transform: translateX(-50%);
}

.radar-label--ne {
  right: 12rpx;
  top: 86rpx;
}

.radar-label--se {
  right: 12rpx;
  bottom: 86rpx;
}

.radar-label--s {
  left: 50%;
  bottom: 8rpx;
  align-items: center;
  transform: translateX(-50%);
}

.radar-label--sw {
  left: 12rpx;
  bottom: 86rpx;
  align-items: flex-end;
}

.radar-label--nw {
  left: 12rpx;
  top: 86rpx;
  align-items: flex-end;
}

.radar-card__hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: #6b7a73;
}

.career {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.career-row {
  display: flex;
  gap: 10rpx;
}

.career-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.career-card--wide {
  width: 100%;
}

.career-card--pressed {
  opacity: 0.82;
}

.career-card__head {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.career-card__icon {
  width: 56rpx;
  height: 56rpx;
}

.career-card__name {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #1c1f21;
}

.career-card__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 29rpx;
  color: #787e6c;
}

.career-card__link {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 29rpx;
  color: #508c10;
}

.services {
  display: flex;
  gap: 10rpx;
}

.service {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  height: 139rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.service--pressed {
  opacity: 0.82;
}

.service__icon {
  width: 64rpx;
  height: 64rpx;
}

.service__icon--flip {
  transform: scaleX(-1);
}

.service__label {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 31rpx;
  color: #1c1f21;
}

.share-row {
  position: relative;
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 4rpx;
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 24rpx;
  color: #1c1f21;
}

.share-row__icon {
  width: 40rpx;
  height: 40rpx;
}

.share-row__hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

.share-row__hit::after {
  border: none;
}

.share-row--pressed {
  opacity: 0.82;
}

.tabbar-spacer {
  height: calc(153rpx + env(safe-area-inset-bottom));
}

/* ---------- 更换背景抽屉 401:359 ---------- */

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
}

.sheet__dim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.32);
}

.sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* 底栏是独立一层，页面 z-index 压不住。底部垫上底栏高度，「完成」才露出来，整块也会往上长一截 */
  padding: 32rpx 0 calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 24rpx);
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
}

.sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto;
  border-radius: 4rpx;
  background: #d8d8d4;
}

.sheet__title {
  padding: 24rpx 32rpx 0;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 49rpx;
  color: #1c1f21;
}

.sheet__sub {
  padding: 8rpx 32rpx 0;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #737a76;
}

.sheet__label {
  padding: 28rpx 32rpx 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 35rpx;
  color: #1c1f21;
}

.swatches {
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx;
}

.swatch {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  font-size: 20rpx;
  font-weight: 500;
  color: #737a76;
}

.swatch--on {
  font-weight: 700;
  color: #1c1f21;
}

.swatch__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.swatch--on .swatch__dot {
  border-color: #83d414;
}

.swatch__fill {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.swatch__dot--photo {
  background: #ffffff;
}

.swatch__fill--empty {
  background: #e8e8e4;
}

.covers {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 32rpx;
}

.cover-pick {
  width: 162.5rpx;
  height: 156rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.cover-pick__img {
  width: 100%;
  height: 100%;
}

.cover-pick--on {
  box-shadow: 0 0 0 4rpx #83d414;
}

.cover-pick--album {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7faf7;
  border: 2rpx solid #d8d8d4;
  font-size: 22rpx;
  color: #737a76;
}

.cover-pick--solid {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--page-tint);
  border: 2rpx solid #d8d8d4;
  font-size: 22rpx;
  color: #1c1f21;
}

.sheet__done {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 686rpx;
  height: 80rpx;
  margin: 40rpx auto 0;
  border-radius: 24rpx;
  background: #83d414;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 41rpx;
  color: #1c1f21;
}
