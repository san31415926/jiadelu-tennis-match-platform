/**
 * ============================================================================
 * 超级杯页样式 —— 视觉刷新草稿 V5
 * ============================================================================
 * 数值来自 Figma node 230:158（信息架构默认态）。设计稿 1px = 1rpx。
 *
 * 【这一页的块】
 *   1. 顶栏 —— 主题渐变 + 居中字标「超级杯」。稿上汉堡 hidden，不要做侧栏
 *   2. 头图 321rpx —— 直边照片 + 叠字 + 指示点。稿上虽有波浪层，按产品要求改成和首页一样的直边
 *   3. 内容白底区 —— 两组 Cover Flow、俱乐部中心按钮、胶囊筛选、赛事卡
 *
 * Cover Flow 中间卡 280×248、两侧 168×176。swiper 必须铺满 750 屏宽，
 * previous/next-margin 各 235 才能露出左右两张。内容区有 32 内边距，
 * 所以 cover-flow 用负边距撑出去，否则当前槽只剩 216，右侧卡会被裁掉。
 */

.super-cup {
  min-height: 100vh;
  background: var(--page-bg);
}

/**
 * 顶栏钉在屏幕最上，下滑列表时字标还在。
 * 写法跟赛事首页同一套：fixed + .topbar-spacer 垫状态栏 + 72rpx。
 * z-index 200 压过头图。
 */
.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  /* JS 还没量到高度时，先用系统安全区垫住，避免字钻进状态栏 */
  padding-top: env(safe-area-inset-top);
  background: var(--header-gradient);
}

/**
 * 跳到海报等二级页后本页还在栈里。fixed 顶栏有的机型会继续挡在下一页上面，
 * 点「返回」其实点到了这条字标。离开时藏掉，回来再亮。
 */
.topbar--parked {
  display: none;
  pointer-events: none;
}

.topbar__row {
  position: relative;
  height: 72rpx;
}

.wordmark {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 1.6rpx;
  color: #1a1f16;
  text-shadow: 0 3rpx 4rpx rgba(13, 20, 5, 0.16);
}

/* ---------- 头图 ---------- */

.hero {
  position: relative;
  width: 100%;
  height: 321rpx;
  overflow: hidden;
  background: var(--header-gradient);
}

.hero__swiper,
.hero__item,
.hero__slide {
  position: relative;
  width: 100%;
  height: 321rpx;
  overflow: hidden;
}

.hero__image {
  width: 100%;
  height: 321rpx;
}

.hero__scrim {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  /* 横向压左，盖住 jpg 旧标题；叠字仍由 hero__copy 画 */
  background: linear-gradient(
    90deg,
    rgba(13, 18, 13, 0.78) 0%,
    rgba(13, 18, 13, 0.32) 42%,
    rgba(13, 18, 13, 0.08) 68%,
    rgba(13, 18, 13, 0.04) 100%
  );
}

.hero__copy {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 36rpx;
  z-index: 1;
  pointer-events: none;
}

.hero__eyebrow {
  font-size: 13rpx;
  font-weight: 600;
  line-height: 18rpx;
  color: var(--accent);
}

.hero__accent {
  width: 28rpx;
  height: 3rpx;
  margin-top: 8rpx;
  border-radius: 1.5rpx;
  background: var(--accent);
}

.hero__title {
  margin-top: 10rpx;
  width: 408rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 46rpx;
  color: #ffffff;
}

.hero__sub {
  margin-top: 8rpx;
  width: 330rpx;
  font-size: 19rpx;
  line-height: 26rpx;
  color: rgba(244, 247, 234, 0.9);
}

.hero__dots {
  position: absolute;
  left: 55rpx;
  top: 192rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
  pointer-events: none;
}

.hero__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.38);
}

.hero__dot--on {
  width: 18rpx;
  border-radius: 4rpx;
  background: var(--accent);
}

/**
 * 内容区。左右 32，块与块 gap 24。画布接到 --page-bg。
 */
.sheet {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 32rpx 8rpx;
  background: var(--page-bg);
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section__title {
  font-size: 30rpx;
  font-weight: 900;
  color: #1f211c;
}

.section__more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #73786b;
}

.section__chevron {
  font-size: 24rpx;
}

/* ---------- Cover Flow ---------- */

.cover-flow {
  width: 750rpx;
  height: 248rpx;
  margin-left: -32rpx;
}

.cover-slide {
  display: flex;
  align-items: center;
  height: 248rpx;
}

/**
 * 当前项居中铺满 280 槽。
 * 上一张靠右贴着中间卡（槽宽 280，卡宽 168，右侧留 12 的 gap）。
 * 下一张靠左对称。更远的 side 卡也居中，滑过去时不会乱跳。
 */
.cover-slide--current {
  justify-content: center;
}

.cover-slide--prev {
  justify-content: flex-end;
  padding-right: 12rpx;
}

.cover-slide--next {
  justify-content: flex-start;
  padding-left: 12rpx;
}

.cover-slide--side {
  justify-content: center;
}

.cover-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 168rpx;
  height: 176rpx;
  padding: 14rpx 8rpx 12rpx;
  border: 3rpx solid transparent;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 8rpx rgba(0, 0, 0, 0.1);
  opacity: 0.7;
}

.cover-card.is-current {
  gap: 10rpx;
  width: 280rpx;
  height: 248rpx;
  padding: 22rpx 8rpx 18rpx;
  border-color: var(--accent);
  opacity: 1;
}

.cover-card--pressed {
  opacity: 0.85;
}

.cover-card__icon {
  width: 92rpx;
  height: 88rpx;
}

.cover-card.is-current .cover-card__icon {
  width: 156rpx;
  height: 148rpx;
}

.cover-card__label {
  width: 100%;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 24rpx;
  text-align: center;
  color: #1f211c;
}

.cover-card.is-current .cover-card__label {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.cover-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 10rpx;
}

.cover-dots__item {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d9d9d4;
}

.cover-dots__item.is-on {
  width: 18rpx;
  border-radius: 4rpx;
  background: var(--accent);
}

/**
 * 进入俱乐部中心。稿上整条 96 高、圆角 20、青绿底黑字。
 */
.club-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: var(--accent);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-text);
}

.club-cta--pressed {
  opacity: 0.85;
}

.club-cta__arrow {
  font-size: 30rpx;
}

.feed {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feed__title {
  font-size: 26rpx;
  font-weight: 900;
  color: #1f211c;
}

.feed__empty {
  padding: 72rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}
