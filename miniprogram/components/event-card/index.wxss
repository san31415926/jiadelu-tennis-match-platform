/* 赛事卡片，Figma node 1:272 / 1:378，两个页面结构完全一致 */

.event-card {
  display: flex;
  gap: 28rpx;
  height: 274rpx;
  padding: 18rpx 0;
  border-radius: var(--radius-card);
  background: var(--card-bg);
  box-shadow: var(--shadow-card);
}

.event-card__photo {
  flex-shrink: 0;
  width: 286rpx;
  height: 238rpx;
  border-radius: var(--radius-photo);
}

.event-card__body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 376rpx;
  height: 238rpx;
  padding-top: 2rpx;
}

.event-card__title {
  height: 34rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-card-title);
}

.event-card__meta {
  display: flex;
  gap: 10rpx;
  height: 24rpx;
}

.event-card__meta-text {
  flex: 1;
  overflow: hidden;
  font-size: 17rpx;
  line-height: 24rpx;
  color: var(--text-muted);
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 三个信息图标都是简单几何形，用矢量背景实现，不占用图片资源 */
.meta-icon {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.meta-icon--location {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='4' fill='%237D8583'/%3E%3C/svg%3E");
}

.meta-icon--time {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='8.1' fill='none' stroke='%237D8583' stroke-width='1.8'/%3E%3Crect x='11' y='5' width='1.8' height='8' rx='0.9' fill='%237D8583'/%3E%3Crect x='11' y='11' width='7' height='1.8' rx='0.9' fill='%237D8583'/%3E%3C/svg%3E");
}

.meta-icon--participants {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3E%3Ccircle cx='6.5' cy='10.5' r='3.5' fill='%237D8583'/%3E%3Ccircle cx='17.5' cy='10.5' r='3.5' fill='%237D8583'/%3E%3Crect x='3' y='15' width='18' height='4' rx='2' fill='%237D8583'/%3E%3C/svg%3E");
}

.event-card__footer {
  position: absolute;
  left: 0;
  right: 4rpx;
  top: 184rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 54rpx;
}

.event-card__action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 54rpx;
  border-radius: var(--radius-button);
  background: var(--brand-green-deep);
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-inverse);
}
