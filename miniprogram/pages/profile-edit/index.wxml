<view class="edit theme-{{theme}}" style="{{themeVars}}">
  <!-- occupy 把吸顶栏高度垫进文档流，下面不再画旧绿波浪头 -->
  <page-nav title="我的资料" variant="mint" occupy="{{true}}" />

  <view class="avatar-block" bindtap="onPickAvatar">
    <view class="avatar-block__frame">
      <image class="avatar-block__photo" src="{{form.avatar}}" mode="aspectFit" />
    </view>
    <view class="avatar-block__hint">点击更换头像，保存后生效</view>
  </view>

  <view class="card">
    <view class="card__title">账号信息</view>
    <view class="row">
      <text class="row__label">昵称</text>
      <input
        class="row__input"
        value="{{form.nickname}}"
        placeholder="请填写"
        placeholder-class="row__ph"
        maxlength="20"
        confirm-type="done"
        cursor-spacing="120"
        data-key="nickname"
        bindinput="onFieldInput"
      />
    </view>
    <view class="row">
      <text class="row__label">手机号</text>
      <input
        class="row__input"
        type="number"
        value="{{form.phone}}"
        placeholder="请填写"
        placeholder-class="row__ph"
        maxlength="11"
        confirm-type="done"
        cursor-spacing="120"
        data-key="phone"
        bindinput="onFieldInput"
      />
    </view>
    <view class="row row--last" bindtap="onCopyUid">
      <text class="row__label">UID</text>
      <view class="row__right">
        <text class="row__value">{{form.uid}}</text>
        <text class="row__arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card__title">报名资料</view>
    <view class="row">
      <text class="row__label">真实姓名</text>
      <input
        class="row__input"
        value="{{form.realName}}"
        placeholder="请填写"
        placeholder-class="row__ph"
        maxlength="20"
        confirm-type="done"
        cursor-spacing="120"
        data-key="realName"
        bindinput="onFieldInput"
      />
    </view>
    <view class="row">
      <text class="row__label">性别</text>
      <view class="pills">
        <view
          wx:for="{{genders}}"
          wx:key="*this"
          class="pill {{form.gender === item ? 'pill--on' : ''}}"
          style="{{form.gender === item ? 'background:' + accent + ';color:' + accentText + ';border-color:' + accent : ''}}"
          data-value="{{item}}"
          bindtap="onGenderTap"
        >{{item}}</view>
      </view>
    </view>
    <view class="row">
      <text class="row__label">惯用手</text>
      <view class="pills">
        <view
          wx:for="{{hands}}"
          wx:key="*this"
          class="pill {{form.hand === item ? 'pill--on' : ''}}"
          style="{{form.hand === item ? 'background:' + accent + ';color:' + accentText + ';border-color:' + accent : ''}}"
          data-value="{{item}}"
          bindtap="onHandTap"
        >{{item}}</view>
      </view>
    </view>
    <view class="row">
      <text class="row__label">所在城市</text>
      <input
        class="row__input"
        value="{{form.city}}"
        placeholder="请填写"
        placeholder-class="row__ph"
        maxlength="20"
        confirm-type="done"
        cursor-spacing="120"
        data-key="city"
        bindinput="onFieldInput"
      />
    </view>
    <view class="row row--last" bindtap="onEditClub">
      <text class="row__label">所属俱乐部</text>
      <view class="row__right">
        <text class="row__value">{{form.club}}</text>
        <text class="row__arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card__title">网球档案</view>
    <view class="row">
      <text class="row__label">常打项目</text>
      <view class="pills">
        <view
          wx:for="{{plays}}"
          wx:key="*this"
          class="pill {{form.play === item ? 'pill--on' : ''}}"
          style="{{form.play === item ? 'background:' + accent + ';color:' + accentText + ';border-color:' + accent : ''}}"
          data-value="{{item}}"
          bindtap="onPlayTap"
        >{{item}}</view>
      </view>
    </view>
    <view class="row">
      <text class="row__label">球龄</text>
      <input
        class="row__input"
        value="{{form.years}}"
        maxlength="10"
        confirm-type="done"
        cursor-spacing="160"
        data-key="years"
        bindinput="onFieldInput"
      />
    </view>
    <view class="tag-block">
      <text class="row__label">个性标签</text>
      <view class="tag-pills">
        <view
          wx:for="{{tagChoices}}"
          wx:key="label"
          class="pill {{item.on ? 'pill--on' : ''}}"
          style="{{item.on ? 'background:' + accent + ';color:' + accentText + ';border-color:' + accent : ''}}"
          data-value="{{item.label}}"
          bindtap="onTagTap"
        >{{item.label}}</view>
        <view
          wx:for="{{customTags}}"
          wx:key="*this"
          class="pill pill--on"
          style="background:{{accent}};color:{{accentText}};border-color:{{accent}}"
          data-value="{{item}}"
          bindtap="onTagTap"
        >{{item}}</view>
      </view>
      <input
        wx:if="{{selectedTags.length < maxTags}}"
        class="tag-input"
        value="{{tagDraft}}"
        maxlength="8"
        confirm-type="done"
        cursor-spacing="160"
        bindinput="onTagDraftInput"
        bindconfirm="onTagConfirm"
      />
    </view>
    <view class="bio">
      <text class="row__label">个人简介</text>
      <textarea
        class="bio__field"
        value="{{form.bio}}"
        placeholder="写一句球场介绍"
        placeholder-class="row__ph"
        maxlength="120"
        auto-height="{{true}}"
        cursor-spacing="160"
        data-key="bio"
        bindinput="onFieldInput"
      />
    </view>
  </view>

  <view class="card">
    <view class="card__title">球员数据（比赛自动生成，不可手改）</view>
    <view class="row row--readonly">
      <text class="row__label">评分</text>
      <text class="row__value">{{form.rating}}</text>
    </view>
    <view class="row row--readonly">
      <text class="row__label">等级</text>
      <text class="row__value">{{form.level}}</text>
    </view>
    <view class="row row--readonly">
      <text class="row__label">积分</text>
      <text class="row__value">{{form.points}}</text>
    </view>
    <view class="row row--readonly">
      <text class="row__label">身价</text>
      <text class="row__value">{{form.marketValue}}</text>
    </view>
    <view class="row row--readonly row--last">
      <text class="row__label">胜场</text>
      <text class="row__value">{{form.wins}}</text>
    </view>
  </view>

  <!-- 垫出底栏高度，最后一张卡片才不会被挡住 -->
  <view class="save-spacer"></view>
  <view class="save-bar">
    <view class="save" style="background:{{accent}};color:{{accentText}}" bindtap="onSave">保存资料</view>
    <view class="footnote">评分 / 积分 / 身价由赛绩更新，其余项均可编辑</view>
  </view>
</view>
