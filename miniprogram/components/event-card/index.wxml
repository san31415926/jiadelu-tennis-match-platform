<view
  class="event-card {{event.featured ? 'event-card--featured' : ''}}"
  bindtap="onCardTap"
  wx:if="{{event}}"
>
  <view class="event-card__main">
    <view class="event-card__poster">
      <image class="event-card__photo" src="{{event.poster}}" mode="aspectFill" />
      <view class="event-card__status" wx:if="{{event.statusLabel}}">{{event.statusLabel}}</view>
      <view class="event-card__recommend" wx:if="{{event.recommended}}">推荐</view>
      <view class="event-card__slots" wx:if="{{event.slotCaption}}">{{event.slotCaption}}</view>
    </view>

    <view class="event-card__body">
      <view class="event-card__title-row">
        <view
          class="event-card__grade event-card__grade--{{event.gradeTone}}"
          wx:if="{{event.grade}}"
        >{{event.grade}}</view>
        <view class="event-card__title">{{event.title}}</view>
      </view>

      <view class="event-card__tags" wx:if="{{event.tags && event.tags.length}}">
        <view
          class="event-tag event-tag--{{item.tone}}"
          wx:for="{{event.tags}}"
          wx:key="label"
        >{{item.label}}</view>
      </view>

      <view class="event-card__meta">
        <view class="meta-icon meta-icon--location"></view>
        <text class="event-card__meta-text">{{event.venue}}</text>
      </view>
      <view class="event-card__meta">
        <view class="meta-icon meta-icon--time"></view>
        <text class="event-card__meta-text">{{event.time}}</text>
      </view>

      <view class="event-card__price" wx:if="{{event.price}}">{{event.price}}</view>
    </view>
  </view>

  <view class="event-card__dots" wx:if="{{event.featured}}">
    <view class="dot dot--on"></view>
    <view class="dot"></view>
    <view class="dot"></view>
  </view>

  <block wx:if="{{event.venueLink}}">
    <view class="event-card__divider"></view>
    <view class="event-card__venue" catchtap="onVenueTap">
      <image class="event-card__venue-logo" src="{{event.poster}}" mode="aspectFill" />
      <text class="event-card__venue-name">{{event.venue}}</text>
      <text class="event-card__chevron">›</text>
    </view>
  </block>
</view>
