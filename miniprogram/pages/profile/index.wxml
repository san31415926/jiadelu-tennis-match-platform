<view class="profile profile--{{profile.theme}} theme-{{theme}}" style="{{themeVars}}">
  <view class="hero {{coverFromAlbum ? 'hero--album' : ''}} {{profile.cover ? '' : 'hero--plain'}}" style="padding-top:{{statusBarHeight + navBarHeight}}px">
    <view class="hero__cover-clip" wx:if="{{profile.cover}}">
      <image
        class="hero__cover"
        src="{{profile.cover}}"
        mode="aspectFill"
      />
    </view>
    <view class="hero__frost"></view>
    <view class="hero__fade"></view>

    <view class="hero__inner">
      <view class="identity">
        <view class="identity__avatar" bindtap="onAvatarTap">
          <image
            class="identity__avatar-img"
            src="{{profile.avatar}}"
            mode="aspectFit"
          />
        </view>
        <view class="identity__info">
          <view
            class="identity__name {{isLoggedIn ? '' : 'identity__name--guest'}}"
            bindtap="onLogin"
          >{{profile.nickname}}</view>
          <view class="identity__uid">{{profile.uid}}</view>
        </view>
        <view
          class="identity__cover-btn"
          bindtap="onOpenCoverSheet"
          hover-class="identity__cover-btn--pressed"
          hover-stay-time="60"
        >更换背景</view>
      </view>

      <view class="bio" bindtap="onEditBio">
        {{profile.bio || '点此添加介绍...'}}
      </view>

      <view class="tags">
        <view class="tag" wx:for="{{tags}}" wx:key="*this" bindtap="onAddTag">{{item}}</view>
        <view class="tag tag--add" bindtap="onAddTag">+ 添加个性标签</view>
      </view>

      <view class="stats">
        <view class="stat">
          <view class="stat__num">{{profile.marketValue}}</view>
          <view class="stat__label">身价</view>
        </view>
        <view class="stat">
          <view class="stat__num">{{profile.points}}</view>
          <view class="stat__label">积分</view>
        </view>
        <view class="stat">
          <view class="stat__num">{{profile.wins}}</view>
          <view class="stat__label">胜场</view>
        </view>
        <view class="stat">
          <view class="stat__num">{{profile.hand}}</view>
          <view class="stat__label">惯用手</view>
        </view>
      </view>
    </view>

    <view
      class="vip"
      style="background:{{accent}};color:{{accentText}}"
      bindtap="onOpenMembership"
      hover-class="vip--pressed"
      hover-stay-time="60"
    >
      <image
        class="vip__crown"
        src="/assets/icons/profile/vip-wheat-tennis.png"
        mode="aspectFit"
      />
      <view class="vip__copy">
        <view class="vip__title">{{memberActive ? '选手会员已开通' : '开通选手会员'}}</view>
        <view class="vip__sub">{{memberActive ? '有效至 ' + memberUntil + ' · 年费不等于单站报名费' : '198元/年 · 报 L-15 / L-25'}}</view>
      </view>
      <view class="vip__cta">{{memberActive ? '查看权益' : '立即开通'}}</view>
    </view>
  </view>

  <view class="body">
    <view class="block">
      <view class="block__head">
        <text class="block__title">战力图</text>
        <view class="block__chip">综合 {{profile.radar.overall}}</view>
      </view>
      <view class="radar-card">
        <view class="radar">
          <canvas
            wx:if="{{!showCoverSheet && !showCropper && !showEditSheet && !showLoginSheet && !showMemberSheet}}"
            type="2d"
            id="radarCanvas"
            class="radar__canvas"
          ></canvas>
          <view class="radar-label radar-label--n">
            <text>发球</text>
            <text class="radar-label__num">{{profile.radar.axes[0].value}}</text>
          </view>
          <view class="radar-label radar-label--ne">
            <text>正手</text>
            <text class="radar-label__num">{{profile.radar.axes[1].value}}</text>
          </view>
          <view class="radar-label radar-label--se">
            <text>反手</text>
            <text class="radar-label__num">{{profile.radar.axes[2].value}}</text>
          </view>
          <view class="radar-label radar-label--s">
            <text>网前</text>
            <text class="radar-label__num">{{profile.radar.axes[3].value}}</text>
          </view>
          <view class="radar-label radar-label--sw">
            <text>步伐</text>
            <text class="radar-label__num">{{profile.radar.axes[4].value}}</text>
          </view>
          <view class="radar-label radar-label--nw">
            <text>体能</text>
            <text class="radar-label__num">{{profile.radar.axes[5].value}}</text>
          </view>
        </view>
        <view class="radar-card__hint">根据近 12 场比赛生成，可随赛绩更新</view>
      </view>
    </view>

    <view class="block">
      <view class="block__title">我的生涯</view>
      <view class="career">
        <view class="career-row">
          <view class="career-card" bindtap="onOpenEdit" hover-class="career-card--pressed" hover-stay-time="60">
            <view class="career-card__head">
              <image class="career-card__icon" src="/assets/icons/profile/profile-info.png" mode="aspectFit" />
              <text class="career-card__name">我的资料</text>
            </view>
            <view class="career-card__meta">资料完成度 {{profile.profileComplete}}</view>
            <view class="career-card__link">编辑资料  →</view>
          </view>
          <view class="career-card" bindtap="onOpenClub" hover-class="career-card--pressed" hover-stay-time="60">
            <view class="career-card__head">
              <image class="career-card__icon" src="/assets/icons/profile/my-club-flag.png" mode="aspectFit" />
              <text class="career-card__name">我的俱乐部</text>
            </view>
            <view class="career-card__meta" wx:if="{{profile.club}}">{{profile.club}}</view>
            <view class="career-card__meta">俱乐部排名 {{profile.clubRank}}</view>
            <view class="career-card__meta">成员 {{profile.clubMembers}}</view>
          </view>
        </view>
        <view class="career-card career-card--wide" bindtap="onOpenRecords" hover-class="career-card--pressed" hover-stay-time="60">
          <view class="career-card__head">
            <image class="career-card__icon" src="/assets/icons/profile/records-trophy.png" mode="aspectFit" />
            <text class="career-card__name">参赛记录</text>
          </view>
          <view class="career-card__meta">{{profile.recordSummary}}</view>
          <view class="career-card__link" wx:if="{{profile.lastEvent}}">最近：{{profile.lastEvent}}  →</view>
        </view>
      </view>
    </view>

    <view class="block">
      <view class="block__title">更多服务</view>
      <view class="services">
        <view class="services__row">
          <view class="service" bindtap="onOpenBusiness" hover-class="service--pressed" hover-stay-time="60">
            <image class="service__icon service__icon--flip" src="/assets/icons/profile/business-handshake.png" mode="aspectFit" />
            <text class="service__label">商务合作</text>
          </view>
          <view class="service" bindtap="onOpenAbout" hover-class="service--pressed" hover-stay-time="60">
            <image class="service__icon service__icon--flip" src="/assets/icons/profile/about-us.png" mode="aspectFit" />
            <text class="service__label">关于我们</text>
          </view>
        </view>
        <view class="services__row">
          <view class="service" bindtap="onOpenService" hover-class="service--pressed" hover-stay-time="60">
            <image class="service__icon" src="/assets/icons/profile/customer-service.png" mode="aspectFit" />
            <text class="service__label">联系客服</text>
          </view>
          <!-- 分享必须用 button open-type="share"，叠在这一格上 -->
          <view class="service">
            <image class="service__icon" src="/assets/icons/profile/share-friends.png" mode="aspectFit" />
            <text class="service__label">分享好友</text>
            <button
              wx:if="{{isLoggedIn}}"
              class="service__hit"
              open-type="share"
              hover-class="service--pressed"
              hover-stay-time="60"
            ></button>
            <view wx:else class="service__hit" bindtap="onNeedLogin"></view>
          </view>
        </view>
      </view>
      <view
        wx:if="{{isLoggedIn}}"
        class="logout-row"
        bindtap="onLogout"
        hover-class="logout-row--pressed"
        hover-stay-time="60"
      >
        <view class="logout-row__icon"></view>
        <text>退出登录</text>
      </view>
    </view>
  </view>

  <view class="tabbar-spacer"></view>

  <!-- 更换背景抽屉，Figma 401:359。蒙层点空白关闭 -->
  <view class="sheet" wx:if="{{showCoverSheet}}">
    <view class="sheet__dim" bindtap="onCloseCoverSheet"></view>
    <view class="sheet__panel" catchtouchmove="onPreventMove">
      <view class="sheet__handle"></view>
      <view class="sheet__title">更换背景</view>
      <view class="sheet__sub">默认是纯色，也可以从相册上传封面</view>
      <view class="sheet__label">背景色</view>
      <view class="swatches">
        <view
          class="swatch {{profile.theme === item.key ? 'swatch--on' : ''}}"
          wx:for="{{themes}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onPickTheme"
        >
          <view class="swatch__dot {{item.key === 'photo' ? 'swatch__dot--photo' : ''}}">
            <view
              wx:if="{{item.swatch}}"
              class="swatch__fill"
              style="background:{{item.swatch}}"
            ></view>
            <image
              wx:elif="{{profile.cover}}"
              class="swatch__fill"
              src="{{profile.cover}}"
              mode="aspectFill"
            />
            <view wx:else class="swatch__fill swatch__fill--empty"></view>
          </view>
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="sheet__label">背景图</view>
      <view class="covers">
        <view
          class="cover-pick cover-pick--solid {{profile.cover ? '' : 'cover-pick--on'}}"
          bindtap="onClearCover"
        >纯色</view>
        <view
          wx:if="{{profile.cover}}"
          class="cover-pick cover-pick--on"
        >
          <image class="cover-pick__img" src="{{profile.cover}}" mode="aspectFill" />
        </view>
        <view class="cover-pick cover-pick--album" bindtap="onPickAlbumCover">+ 相册</view>
      </view>
      <view class="sheet__done" bindtap="onCloseCoverSheet">完成</view>
    </view>
  </view>

  <!-- 介绍 / 个性标签抽屉。不要用系统 showModal，那套深色框和本页对不上。 -->
  <view class="sheet" wx:if="{{showEditSheet}}">
    <view class="sheet__dim" bindtap="onCloseEditSheet"></view>
    <view class="sheet__panel" catchtouchmove="onPreventMove">
      <view class="sheet__handle"></view>
      <block wx:if="{{showEditSheet === 'bio'}}">
        <view class="sheet__title">编辑介绍</view>
        <textarea
          class="sheet-field"
          value="{{bioDraft}}"
          maxlength="120"
          auto-height="{{true}}"
          cursor-spacing="120"
          bindinput="onBioDraftInput"
        />
      </block>
      <block wx:else>
        <view class="sheet__title">个性标签</view>
        <view class="sheet-pills">
          <view
            wx:for="{{tagChoices}}"
            wx:key="label"
            class="sheet-pill {{item.on ? 'sheet-pill--on' : ''}}"
            style="{{item.on ? 'background:' + accent + ';color:' + accentText + ';border-color:' + accent : ''}}"
            data-value="{{item.label}}"
            bindtap="onSheetTagTap"
          >{{item.label}}</view>
          <view
            wx:for="{{customTags}}"
            wx:key="*this"
            class="sheet-pill sheet-pill--on"
            style="background:{{accent}};color:{{accentText}};border-color:{{accent}}"
            data-value="{{item}}"
            bindtap="onSheetTagTap"
          >{{item}}</view>
        </view>
        <input
          wx:if="{{selectedTags.length < maxTags}}"
          class="sheet-input"
          value="{{tagDraft}}"
          maxlength="8"
          confirm-type="done"
          cursor-spacing="120"
          bindinput="onTagDraftInput"
          bindconfirm="onSheetTagConfirm"
        />
      </block>
      <view
        class="sheet__done"
        style="background:{{accent}};color:{{accentText}}"
        bindtap="onConfirmEditSheet"
      >完成</view>
    </view>
  </view>

  <!-- 登录抽屉。协议勾选是我们画的；选手机号那一层才是微信自带 getPhoneNumber。 -->
  <view class="sheet" wx:if="{{showLoginSheet}}">
    <view class="sheet__dim" bindtap="onCloseLoginSheet"></view>
    <view class="sheet__panel" catchtouchmove="onPreventMove">
      <view class="sheet__handle"></view>
      <block wx:if="{{loginDoc}}">
        <view class="login-back" bindtap="onCloseLoginDoc">‹ 返回</view>
        <view class="sheet__title">{{loginDocTitle}}</view>
        <scroll-view scroll-y class="login-doc" show-scrollbar="{{false}}">
          <text class="login-doc__text">{{loginDocText}}</text>
        </scroll-view>
      </block>
      <block wx:else>
        <view class="sheet__title">登录 LTJIMMY</view>
        <view class="sheet__sub">登录后报名赛事、保存资料、加入俱乐部</view>
        <view class="login-agree" bindtap="onToggleLoginAgree">
          <view
            class="login-check {{loginAgreed ? 'login-check--on' : ''}}"
            style="{{loginAgreed ? 'background:' + accent + ';border-color:' + accent + ';color:' + accentText : ''}}"
          >{{loginAgreed ? '✓' : ''}}</view>
          <view class="login-agree__text">
            我已阅读并同意
            <text class="login-agree__link" catchtap="onOpenLoginDoc" data-doc="terms">《服务条款》</text>
            和
            <text class="login-agree__link" catchtap="onOpenLoginDoc" data-doc="privacy">《隐私协议》</text>
          </view>
        </view>
        <button
          wx:if="{{loginAgreed}}"
          class="login-btn"
          style="background:{{accent}};color:{{accentText}}"
          hover-class="login-btn--pressed"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
        >授权手机号并登录</button>
        <view
          wx:else
          class="login-btn login-btn--off"
          bindtap="onNeedAgree"
        >授权手机号并登录</view>
        <view class="login-cancel" bindtap="onCloseLoginSheet">取消</view>
      </block>
    </view>
  </view>

  <!-- 开通会员：本页抽屉，不要跳 membership 页。点蒙层关闭，不要「返回」。 -->
  <view class="sheet" wx:if="{{showMemberSheet}}">
    <view class="sheet__dim" bindtap="onCloseMemberSheet"></view>
    <view class="sheet__panel sheet__panel--mint" catchtouchmove="onPreventMove">
      <view class="sheet__handle"></view>
      <view class="sheet__title">开通选手会员</view>
      <view class="sheet__sub">198 元/年，解锁巡回赛报名。年费不是免单站费。</view>
      <scroll-view class="member-plans" scroll-x show-scrollbar="{{false}}">
        <view
          wx:for="{{memberPlans}}"
          wx:key="key"
          class="member-plan {{activePlan === item.key ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectPlan"
        >
          <view class="member-plan__flag" wx:if="{{item.recommended}}">推荐</view>
          <view class="member-plan__name">{{item.name}}</view>
          <view class="member-plan__badge">{{item.badge}}</view>
          <view class="member-plan__price">
            <text class="member-plan__yen">¥</text>
            <text class="member-plan__num">{{item.price}}</text>
          </view>
          <view class="member-plan__origin" wx:if="{{item.origin}}">¥ {{item.origin}}</view>
        </view>
      </scroll-view>
      <view class="member-hint">
        <text>微信支付尚未开通。运营把「会员有效至」写成日期即可放行</text>
        <view class="member-hint__q">?</view>
      </view>
      <view class="sheet__label">支付方式</view>
      <view class="member-pays">
        <view
          wx:for="{{memberPays}}"
          wx:key="key"
          class="member-pay {{activePay === item.key ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectPay"
        >
          <image
            wx:if="{{item.key === 'wechat'}}"
            class="wx-mark"
            src="/assets/icons/pay/wechat.png"
            mode="aspectFit"
          />
          <view wx:else class="member-pay__mark member-pay__mark--{{item.key}}">{{item.mark}}</view>
          <text>{{item.label}}</text>
        </view>
      </view>
      <view
        class="sheet__done"
        style="background:{{accent}};color:{{accentText}}"
        bindtap="onMemberCheckout"
      >
        <text>{{payLabel}}</text>
        <text class="member-save" wx:if="{{saveHint}}">{{saveHint}}</text>
      </view>
      <view class="member-agree" bindtap="onShowMemberAgree">开通代表同意《选手会员协议》。年费 ≠ 单站报名费，不含 ATP/ITF 官方积分</view>
    </view>
  </view>

  <image-cropper
    wx:if="{{showCropper}}"
    src="{{cropSrc}}"
    aspect-ratio="{{cropRatio}}"
    bind:confirm="onCropConfirm"
    bind:cancel="onCropCancel"
  />
</view>
