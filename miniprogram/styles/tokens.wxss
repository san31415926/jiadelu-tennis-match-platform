/**
 * ============================================================================
 * 设计 token —— 全站视觉的总开关
 * ============================================================================
 *
 * 【这个文件是干什么的】
 * 圆角、阴影、字色、关键高度写在这里，页面用 var(--变量名) 引用。
 * 顶栏 / 页底 / 按钮选中色不要只改这里——运行时换色看 utils/theme.ts 的 THEME_CHROME。
 *
 * 【取值来源】
 * 全部来自 Figma 文件「网球赛事总结」(nzKWauHC37fyjpAtA3rjfd) 的节点标注，
 * 不是看图估的。每条后面标了对应的 Figma 节点号，方便回去核对。
 *
 * 【关于 rpx 这个单位】
 * rpx 是小程序的自适应单位，规则是：屏幕宽度永远等于 750rpx。
 * 因为设计稿画板宽度正好是 750px，所以设计稿上量到的 1px 直接写成 1rpx 即可，
 * 不需要任何换算。屏幕越宽，1rpx 换算出的实际尺寸越大，所以布局能自动适配
 * 各种手机。在 iPhone 上大约 1rpx = 0.5pt。
 *
 * 【怎么改】
 * 改颜色：运行时强调色改 utils/theme.ts 的 THEME_CHROME.accent，不要只改 --brand-lime。
 *        --brand-lime 是旧主色备份，冷启动默认强调色是薄荷 --accent。
 * 改圆角：数值越大越圆。--radius-card 从 28rpx 调到 0 会让赛事卡片变成方角。
 * 改阴影：格式是 "横向偏移 纵向偏移 模糊半径 颜色"，把模糊半径调大会更朦胧。
 *
 * 【注意】
 * 顶栏、页底、按钮选中色的运行时换色在 utils/theme.ts + 根节点 style="{{themeVars}}"。
 * 这里 page {} 里的值只是冷启动默认（薄荷），JS 还没跑完时先别闪成青柠。
 */
page {
  /* --------------------------------------------------------------------------
   * 一、头部渐变
   * ------------------------------------------------------------------------ */

  /* 首页与超级杯顶栏。冷启动默认薄荷，对齐「我的」V5。
     运行时换色不要改这里，去 styles/theme.wxss 的 .theme-*。
     90deg 从左到右。二级页从上往下的头用 --header-gradient-down。 */
  --header-gradient: linear-gradient(90deg, #c8f4e8 0%, #b8eddc 48%, #66c4b4 100%);

  /* 二级页从上往下的竖渐变。末端要接到 --page-bg，接头才没有色差。 */
  --header-gradient-down: linear-gradient(180deg, #b8eddc 0%, #d6f5e8 55%, #f0fcf7 100%);

  /* 吸顶返回栏的实色。必须盖住下面的字，所以不用半透明。 */
  --page-nav-bg: #b8eddc;

  /* 顶栏取不到渐变时的实色，也给 wx.setBackgroundColor 的顶部露底对齐。 */
  --header-solid: #b8eddc;
  --accent: #66c4b4;
  --accent-text: #14211a;

  /* --------------------------------------------------------------------------
   * 二、品牌绿系列（按用途区分，不要混用）
   * ------------------------------------------------------------------------ */

  /* 旧稿筛选选中绿。现页选中走 --accent（主题强调色），这项目录保留给还没换的稿。 */
  --brand-lime: #83d414;

  /* 报名按钮那个更深的绿（Figma node 1:293）。
     它比 --brand-lime 深，是为了在白底卡片上更突出。
     改它会影响：所有赛事卡片右下角的「立即报名 / 团队报名」按钮。 */
  --brand-green-deep: #54b50a;

  /* 底栏光晕 / 选中字：现页用主题 accent（见 custom-tab-bar），这两项是旧稿备份。 */
  --brand-halo: #e6ffb0;

  /* 底栏当前 Tab 的文字颜色（旧稿）。未选中见 --text-tabbar-idle。 */
  --brand-green-text: #59850a;

  /* --------------------------------------------------------------------------
   * 三、背景色
   * ------------------------------------------------------------------------ */

  /* 页面底色。默认全站薄荷。换主题时 styles/theme.wxss 会覆盖它。
     波浪改成 mask 吃这个变量（见 app.wxss .header__wave），不要再改 SVG fill。
     下拉露底：冷启动看 app.json，换色后看 wx.setBackgroundColor。 */
  --page-bg: #f0fcf7;

  /* 首页七宫格区域的背景（Figma node 1:239）。
     179.4deg 是从上往下略微倾斜，三段色标做出"中间白、上下泛绿"的效果。
     想让宫格区变纯白 → 三个颜色都改成 #ffffff。 */
  --grid-gradient: linear-gradient(
    179.4deg,
    #f9ffeb 6.58%,
    #ffffff 45.23%,
    #f2ffd6 97.05%
  );

  /* 旧稿列表区浅绿渐变。现页画布已统一成 --page-bg，避免一页青柠、一页浅灰。 */
  --feed-gradient: var(--page-bg);

  /* 卡片、列表行、筛选条的白底。Figma 里叫 tennis-color-surface-card。 */
  --card-bg: #ffffff;

  /* --------------------------------------------------------------------------
   * 四、文字颜色（按层级从深到浅）
   * ------------------------------------------------------------------------ */

  /* 页面顶部大标题，如「LTJIMMY赛事」「超级杯」。 */
  --text-nav-title: #263312;

  /* 轮播主标题，如「广佛俱乐部联名赛」。 */
  --text-banner-title: #14210a;

  /* 轮播副标题，如「球员精彩瞬间 · 点击查看」。比主标题浅，形成层次。 */
  --text-banner-sub: #50662a;

  /* 宫格图标下方的文字，如「球员排行」「赛事日历」。 */
  --text-grid-label: #333b2e;

  /* 筛选 Tab 选中时的文字色（现页底色走 --accent，这项目录给还没换的稿）。 */
  --text-tab-active: #10140e;

  /* 次要信息的统一灰色：筛选 Tab 未选中文字、赛事卡片的地点/时间/人数、
     各种空状态提示。改它会一次影响很多地方，调深会让整体更"重"。 */
  --text-muted: #7d8583;

  /* 赛事卡片标题，如「7.0混双评级赛」。 */
  --text-card-title: #1b201d;

  /* 底栏未选中 Tab 的文字色。 */
  --text-tabbar-idle: #6b7566;

  /* 深色底上的白字，如报名按钮里的文字。 */
  --text-inverse: #ffffff;

  /* --------------------------------------------------------------------------
   * 五、轮播指示点
   * ------------------------------------------------------------------------ */

  /* 当前那一页的点（深色）。 */
  --dot-active: #294308;

  /* 其余的点。带 0.42 透明度，所以在不同深浅的渐变背景上都不刺眼。 */
  --dot-idle: rgba(83, 119, 36, 0.42);

  /* --------------------------------------------------------------------------
   * 六、圆角（数值越大越圆，改成 0 就是直角）
   * ------------------------------------------------------------------------ */

  /* 赛事列表区外框的大圆角，视觉上把列表"托起来"。 */
  --radius-feed: 40rpx;

  /* 赛事卡片。 */
  --radius-card: 28rpx;

  /* 卡片里那张球场照片。 */
  --radius-photo: 22rpx;

  /* 筛选 Tab 的药丸形状。它等于 Tab 高度(46rpx)的一半，
     所以看起来是完美的半圆端。如果你改了 Tab 高度，这里也要跟着改成新高度的一半。 */
  --radius-tab: 23rpx;

  /* 报名按钮。同理，等于按钮高度(54rpx)的一半。 */
  --radius-button: 27rpx;

  /* --------------------------------------------------------------------------
   * 七、阴影
   * ------------------------------------------------------------------------ */

  /* 赛事卡片的投影（Figma node 1:272）。
     四个值依次是：横向偏移 / 纵向偏移 / 模糊半径 / 颜色。
     纵向偏移调大会让卡片看起来"浮"得更高；
     模糊半径调大会更柔和；把透明度 0.12 调大会更明显。 */
  --shadow-card: 0 10rpx 12rpx rgba(31, 46, 31, 0.12);

  /* --------------------------------------------------------------------------
   * 八、关键高度（这些数值和设计稿严格对应，改动会影响整页布局）
   * ------------------------------------------------------------------------ */

  /* 首页/超级杯头部渐变区的高度，不含手机状态栏（Figma node 1:208）。
     状态栏高度由 JS 在运行时测量后以 padding-top 形式追加，
     所以真机上头部总高 = 状态栏 + 321rpx。 */
  --header-height: 321rpx;

  /* 旧宫格区高度。超级杯 V5 已改成 Cover Flow，目前没有页面读这个变量。
     先留着，万一哪页还要还原宫格，高度能对上。 */
  --grid-height: 350rpx;

  /* 状态筛选条的高度。 */
  --filter-height: 46rpx;

  /* 自定义底栏的高度，不含手机底部安全区（Figma node 1:295）。
     页面底部靠 .tabbar-spacer 撑出这么高的空白，避免内容被底栏压住。 */
  --tabbar-height: 153rpx;

  /* 底栏未选中图标的不透明度。设计里就是 52%，
     所以未选中的图标看起来是"褪色"的，而不是换了一张灰色图片。
     调到 1 会让三个图标一样鲜艳，选中态就只能靠光晕和文字色区分了。 */
  --tabbar-icon-idle-opacity: 0.52;
}
