/**
 * ============================================================================
 * 头部轮播样式
 * ============================================================================
 * 渐变背景、波浪的基础样式在 app.wxss 里。这一页把页标题从轮播图里拆出来，
 * 单独占状态栏下面那一行绿条，所以这里要把全局 .header__title 的绝对定位覆盖掉。
 *
 * 【轮播范围】
 * header__inner（321rpx）整块都是图。底部波浪叠在图上。
 * 赛事名按设计稿 36 / 19 画进 jpg；指示点用 WXML，好跟当前张走。
 * 原图在 测试图/轮播图/，小程序用压缩 jpg，路径在 mock/home.ts。
 */

.header {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-bottom: -2rpx;
  background: var(--header-gradient);
}

/**
 * 覆盖 app.wxss 里的绝对定位。组件 styleIsolation 是 apply-shared，
 * 不写这几行标题会重新叠回图顶上。
 */
.header__title {
  position: relative;
  left: auto;
  top: auto;
  z-index: 4;
  height: 44px;
  box-sizing: border-box;
  pointer-events: none;
  text-shadow: none;
}

.header__inner {
  position: relative;
  width: 100%;
  height: var(--header-height);
  overflow: hidden;
  /* swiper 原生组件底是深色，底下哪怕露 1px 也会变成一条黑横线 */
  background: #fbfff4;
}

/** 波浪必须盖在轮播图上面，才能切出设计稿那条白边 */
.header__wave {
  z-index: 2;
}

/**
 * 盖住头部最底那一线。高度落在波浪实心填充里，不会切到曲线。
 * 图文件底边和微信 swiper 都可能露出 1px 深色缝。
 */
.header__inner::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  height: 24rpx;
  background: #fbfff4;
  pointer-events: none;
}

/**
 * 轮播框 = 整块绿色头部。
 *
 * 【为什么多包一层 view】
 * 微信的 swiper 是原生组件，直接给它 position:absolute 经常不生效，
 * 会从头部顶上以默认 150px 高度铺开。定位写在这层普通 view 上才稳。
 *
 * 自动播放在 index.wxml 的 swiper 上：
 *   interval="5000" 是 5 秒切一张
 *   duration="400"  是切换动画时长
 *   删掉 autoplay 就不自动播放
 */
.banner {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  /* 多出的高度被 header__inner overflow 裁掉，切掉 jpg 底边那条深色像素 */
  height: calc(100% + 12rpx);
}

.banner__swiper {
  width: 100%;
  height: calc(var(--header-height) + 12rpx);
  border: none;
  background: #fbfff4;
}

.banner__slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #fbfff4;
}

.banner__image {
  display: block;
  width: 100%;
  height: 100%;
  vertical-align: top;
}

/**
 * 指示点。位置来自 Figma node 1:235（left 55 / top 192）。
 * 照片底是深色，选中用品牌青柠，未选中用半透明白。
 */
.banner__dots {
  position: absolute;
  left: 55rpx;
  top: 192rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 8rpx;
  pointer-events: none;
}

.banner__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.38);
}

.banner__dot--on {
  width: 22rpx;
  border-radius: 6rpx;
  background: #d4f34a;
}
