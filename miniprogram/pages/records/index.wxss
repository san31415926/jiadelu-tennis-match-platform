/**
 * ============================================================================
 * 参赛记录页样式
 * ============================================================================
 * 草稿 Figma「参赛记录 / V5」(419:359)。
 * 旧绿波浪头已经删掉，occupy 吸顶栏。筛选和胜场标走主题强调色。
 *
 * 【想改顶卡数字】改 mock/records.ts 的 RECORDS_SUMMARY，样式不用动。
 */

.records {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: var(--page-bg);
}

.summary {
  position: relative;
  z-index: 1;
  margin: 8rpx 28rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 12rpx rgba(38, 56, 20, 0.08);
}

.summary__title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.summary__trophy {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.summary__title-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.summary__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #1c1f21;
}

.summary__recent {
  font-size: 22rpx;
  line-height: 29rpx;
  color: #1a7a5c;
}

.summary__stats {
  display: flex;
  margin-top: 20rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat__num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
  color: #1c1f21;
}

.stat__num--win {
  color: #54b50a;
}

.stat__label {
  font-size: 22rpx;
  line-height: 29rpx;
  color: #7d8583;
}

.filters {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx 0;
}

.filters__chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 24rpx;
  border: 2rpx solid #cfd2c6;
  border-radius: 26rpx;
  background: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  color: #1c1f21;
}

.filters__chip.is-active {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--accent-text);
  font-weight: 700;
  box-shadow: 0 4rpx 10rpx rgba(20, 24, 16, 0.16);
}

.list {
  padding: 16rpx 28rpx 0;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 22rpx 24rpx 22rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 12rpx rgba(38, 56, 20, 0.08);
}

.row--pressed {
  opacity: 0.86;
}

.row__info {
  flex: 1;
  min-width: 0;
}

.row__title {
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
  color: #1c1f21;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row__meta {
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 20rpx;
  line-height: 26rpx;
  color: #7d8583;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row__result {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.badge {
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 26rpx;
}

.badge--win {
  background: var(--accent);
  color: var(--accent-text);
}

.badge--loss {
  background: #e8ece0;
  color: #7d8583;
}

.row__score {
  font-size: 20rpx;
  line-height: 26rpx;
  color: #7d8583;
}

.row__arrow {
  margin-left: 10rpx;
  font-size: 32rpx;
  line-height: 32rpx;
  color: #7d8583;
}

.list__empty {
  padding: 80rpx 0;
  font-size: 24rpx;
  text-align: center;
  color: #7d8583;
}
