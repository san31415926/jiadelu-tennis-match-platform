/**
 * ============================================================================
 * 俱乐部榜单页样式 —— 视觉刷新草稿 V5
 * ============================================================================
 * 数值来自 Figma node 287:292（本月 × 积分）。设计稿 1px = 1rpx。
 * 旧绿波浪头已经删掉，occupy 吸顶栏。本月 / 累计走主题强调色。
 *
 * 想改本月/累计的选中色 → 跟全站 accent 走
 * 想改展开条文案样式 → .show-more
 */

.club-ranking {
  min-height: 100vh;
  background: var(--page-bg);
}

.rank-tools {
  padding: 16rpx 40rpx 24rpx;
}

.scope-tabs {
  display: flex;
  gap: 12rpx;
  height: 58rpx;
}

.scope-tabs__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border: 2rpx solid #cfd2c6;
  border-radius: 29rpx;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  color: #3d4436;
}

.scope-tabs__item.is-active {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--accent-text);
}

.metric-tabs {
  display: flex;
  gap: 46rpx;
  margin-top: 20rpx;
}

.metric-tabs__item {
  position: relative;
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #6b7059;
}

.metric-tabs__item.is-active {
  color: #1f2114;
}

.metric-tabs__underline {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 2.5rpx;
  background: var(--accent);
}

/* ---------- 领奖台 ---------- */

.podium {
  position: relative;
  height: 454rpx;
  background: var(--page-bg);
}

.podium__confetti {
  position: absolute;
  width: 150rpx;
  height: 210rpx;
}

.podium__confetti--1 {
  left: 42rpx;
  top: 8rpx;
  opacity: 0.45;
}

.podium__confetti--2 {
  left: 245rpx;
  top: 19rpx;
  opacity: 0.45;
}

.podium__confetti--3 {
  left: 444rpx;
  top: 19rpx;
  opacity: 0.45;
}

.podium__confetti--4 {
  left: 575rpx;
  top: 0;
  opacity: 0.38;
}

/**
 * 一座台 + 一个圈的合成切图。
 * 圆心百分比来自 tools/measure-podium-circles.cjs，和球员排行共用切图，不要单独拖。
 */
.podium__unit {
  position: absolute;
}

.podium__unit--first {
  left: 255rpx;
  top: 48rpx;
  width: 240rpx;
  height: 310rpx;
}

.podium__unit--second {
  left: 48rpx;
  top: 72rpx;
  width: 220rpx;
  height: 287rpx;
}

.podium__unit--third {
  left: 482rpx;
  top: 94rpx;
  width: 220rpx;
  height: 265rpx;
}

.podium__unit-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.podium__unit-avatar {
  position: absolute;
  z-index: 0;
  left: 21.54%;
  top: 4.72%;
  width: 57.69%;
  height: 44.25%;
  border-radius: 50%;
}

.podium__unit-avatar--first {
  left: 25.58%;
  top: 4.09%;
  width: 49.81%;
  height: 38.54%;
}

.podium__unit--third .podium__unit-avatar {
  left: 21.92%;
  top: 4.55%;
  width: 56.35%;
  height: 46.73%;
}

.podium__col {
  position: absolute;
  top: 369rpx;
  text-align: center;
}

.podium__col--second {
  left: 48rpx;
  width: 220rpx;
}

.podium__col--first {
  left: 255rpx;
  width: 240rpx;
}

.podium__col--third {
  left: 482rpx;
  width: 220rpx;
}

.podium__name {
  height: 34rpx;
  overflow: hidden;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #1f2114;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.podium__name--first {
  font-weight: 700;
}

.podium__club {
  height: 28rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #6b7059;
}

.podium__score {
  height: 42rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
  color: #1f2114;
}

.podium__score--first {
  height: 48rpx;
  font-size: 38rpx;
  line-height: 48rpx;
}

/* ---------- 4 名之后的列表 ---------- */

.list {
  margin: 34rpx 30rpx 0;
  width: 690rpx;
  overflow: hidden;
}

.list__row {
  display: flex;
  align-items: center;
  height: 94rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid #dbdecc;
}

.list__rank {
  width: 86rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2114;
}

.list__avatar-slot {
  flex-shrink: 0;
  margin-left: 19rpx;
}

.list__detail {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  overflow: hidden;
}

.list__nickname {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2114;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.list__club {
  margin-top: 5rpx;
  overflow: hidden;
  font-size: 17rpx;
  line-height: 24rpx;
  color: #6b7059;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.list__score {
  width: 150rpx;
  padding-right: 24rpx;
  text-align: right;
  font-size: 32rpx;
  color: #1f2114;
}

.list__empty {
  padding: 72rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #6b7059;
}

/* ---------- 展开与我的排名 ---------- */

/**
 * V5「查看全部 20 家俱乐部」是顶部分割线 + 灰字 + 青绿箭头，
 * 不是球员排行那种绿色药丸。收起态文案换成「收起」。
 */
.show-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 690rpx;
  height: 64rpx;
  margin: 8rpx 30rpx 0;
  padding-top: 16rpx;
  border-top: 1rpx solid #e5e8e0;
  font-size: 24rpx;
  font-weight: 500;
  color: #101214;
}

.show-more__arrow {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent);
}

.my-rank-spacer {
  height: calc(134rpx + env(safe-area-inset-bottom));
}

.my-rank {
  position: fixed;
  left: 42rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  width: 666rpx;
  height: 94rpx;
  padding: 0 21rpx;
  border: 1rpx solid #e0e5d6;
  border-radius: 32rpx;
  background: var(--card-bg);
  box-shadow: 0 4rpx 10rpx rgba(51, 64, 31, 0.12);
}

.my-rank__trophy {
  flex-shrink: 0;
  width: 70rpx;
  height: 64rpx;
}

.my-rank__summary {
  flex: 1;
  margin-left: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1f2114;
}

.my-rank__action {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
}

.my-rank__cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-left: 20rpx;
  border-radius: 18rpx;
  background: var(--accent);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent-text);
}
