@import '../../styles/subpage-header.wxss';

/**
 * ============================================================================
 * 联系客服页样式
 * ============================================================================
 * 终稿 node 68:655。头部和图标与商务合作同款，卡片里是 630×88 的青柠胶囊按钮。
 * button 默认有边框和内边距，下面全部清掉，才长得像设计稿。
 */

.info {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #f0ffd5;
}

.hero-icon {
  position: relative;
  z-index: 2;
  width: 120rpx;
  height: 120rpx;
  margin: -114rpx auto 0;
}

.kicker {
  margin-top: 12rpx;
  height: 28rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  text-align: center;
  color: #7d8583;
}

.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 694rpx;
  margin: 14rpx 28rpx 0;
  padding: 32rpx 32rpx 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #abd7a7 0%, rgba(126, 224, 117, 0.6) 100%);
  box-shadow: 0 10rpx 12rpx rgba(31, 46, 31, 0.12);
}

.card__title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
  color: #42385f;
}

.card__sub {
  margin-top: 16rpx;
  width: 580rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
  color: #7d8583;
}

.contact-btn {
  width: 630rpx;
  height: 88rpx;
  margin: 16rpx 0 0;
  padding: 0;
  border: none;
  border-radius: 44rpx;
  background: #54b50a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  color: #ffffff;
}

.contact-btn::after {
  border: none;
}

.card__hours {
  margin-top: 16rpx;
  width: 580rpx;
  font-size: 18rpx;
  line-height: 23rpx;
  text-align: center;
  color: #7d8583;
}
