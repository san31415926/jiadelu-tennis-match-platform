/**
 * ============================================================================
 * 我的页样式 —— 视觉刷新草稿 V5
 * ============================================================================
 * 数值来自 Figma node 302:103（薄荷资料头）和 401:359（更换背景抽屉）。
 * 设计稿 1px = 1rpx。
 *
 * 【这一页的块】
 *   1. 薄荷霜化头图：封面模糊 + 半透明色罩，头像 120，四列数据
 *   2. VIP 条走主题强调色 --accent，不要写死青绿
 *   3. 战力图白卡 + canvas 雷达
 *   4. 我的生涯两列 + 参赛记录通栏
 *   5. 更多服务 2×2 宫格（分享也占一格），底下通栏退出登录
 *   6. 更换背景底部抽屉
 *   7. 编辑介绍 / 个性标签也走同一套抽屉，输入框浅薄荷底 #f4f8f4（和资料页一致）
 *   8. 登录抽屉：协议勾选是自制的；选手机号才是微信 getPhoneNumber
 *
 * 旧绿波浪头、金圈领奖台、七项菜单列表已经删掉。
 * 换主题只改 .profile--* 的霜化色。没有封面时走 .hero--plain，只显示纯色。
 * 相册打球照走 .hero--album：只轻轻一糊，名字和「更换背景」中间的空位把图漏出来。
 */

.profile {
  min-height: 100vh;
  background: var(--page-bg);
}

.profile--mint {
  --frost: rgba(184, 237, 220, 0.82);
  --fade-end: var(--page-bg);
  --page-tint: #b8eddc;
}

.profile--lime {
  --frost: rgba(212, 243, 74, 0.72);
  --fade-end: var(--page-bg);
  --page-tint: #d4f34a;
}

.profile--gold {
  --frost: rgba(226, 177, 90, 0.55);
  --fade-end: var(--page-bg);
  --page-tint: #e2b15a;
}

.profile--sky {
  --frost: rgba(110, 180, 224, 0.58);
  --fade-end: var(--page-bg);
  --page-tint: #6eb4e0;
}

.profile--dusk {
  --frost: rgba(224, 138, 170, 0.5);
  --fade-end: var(--page-bg);
  --page-tint: #e08aaa;
}

.profile--photo {
  --frost: rgba(184, 237, 220, 0.28);
  --fade-end: var(--page-bg);
  --page-tint: #b8eddc;
}

.hero {
  position: relative;
  overflow: hidden;
  background: var(--page-tint);
  /* 实际顶距由 wxml 写成状态栏 + 胶囊条，避免「更换背景」贴着退出 */
}

/**
 * 封面铺满头图这一块，高度跟着内容走，不要写死 1120rpx。
 * 写死会把正方形头像放大到整屏高，中间空位只剩眼睛和发带。
 * 相册照再走 .hero--album，糊得更轻。
 */
.hero__cover-clip {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.hero__cover {
  width: 100%;
  height: 100%;
  filter: blur(12px);
  /* 只为糊边留一丁点，再大就会把人放大到只剩五官 */
  transform: scale(1.04);
}

.hero__frost {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  /* 左右罩住名字和「更换背景」，中间空位把封面漏出来 */
  background: linear-gradient(
    90deg,
    var(--frost) 0%,
    var(--frost) 22%,
    rgba(255, 255, 255, 0.12) 38%,
    rgba(255, 255, 255, 0.12) 70%,
    var(--frost) 100%
  );
}

/**
 * 自己选的打球照：只虚一点点，还能认出人。
 * 霜化改成横向渐变——头像/名字左侧、更换背景右侧略罩，
 * 中间那一大块空位几乎不罩，照片从这里漏出来。
 */
.hero--album .hero__cover {
  filter: blur(6px);
  transform: scale(1.03);
}

.hero--album .hero__frost {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.55) 0%,
    rgba(255, 255, 255, 0.28) 22%,
    rgba(255, 255, 255, 0.04) 36%,
    rgba(255, 255, 255, 0.04) 72%,
    rgba(255, 255, 255, 0.36) 100%
  );
}

/* 没有封面图时不要横向漏空，否则纯色中间会发白 */
.hero--plain .hero__frost {
  background: transparent;
}

.hero__fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(180deg, transparent 0%, var(--fade-end) 100%);
}

.hero__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  padding: 28rpx 32rpx 20rpx;
}

.identity {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.identity__avatar {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #ffffff;
}

/**
 * 微信里 image 自己写 border-radius 经常裁不圆。
 * 外圈负责圆形，图用 aspectFit 完整放进圆里，避免上传后脑袋被切掉。
 * 竖图左右会留白、横图上下会留白，这是「看全图」的代价。
 */
.identity__avatar-img {
  display: block;
  width: 100%;
  height: 100%;
}

.identity__info {
  flex: 1;
  min-width: 0;
}

.identity__name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 46rpx;
  color: #000000;
}

.identity__name--guest {
  text-decoration: underline;
}

.identity__uid {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: #111111;
}

.identity__cover-btn {
  width: 120rpx;
  height: 40rpx;
  line-height: 37rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 500;
  color: #1f1f1f;
  border: 1.5rpx solid #ffffff;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.32);
}

.identity__cover-btn--pressed {
  opacity: 0.7;
}

.bio {
  font-size: 24rpx;
  line-height: 31rpx;
  color: #111111;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 22rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: #1a1a1a;
}

.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat__num {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 46rpx;
  color: #000000;
}

.stat__label {
  font-size: 20rpx;
  line-height: 26rpx;
  color: #111111;
}

.vip {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin: 0 24rpx 12rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  border-radius: 32rpx;
  /* 底色和字色由内联 accent / accentText 写入，这里只是默认薄荷 */
  background: var(--accent);
  color: var(--accent-text);
}

.vip--pressed {
  opacity: 0.88;
}

.vip__crown {
  flex-shrink: 0;
  width: 48rpx;
  height: 40rpx;
}

.vip__copy {
  flex: 1;
  min-width: 0;
}

.vip__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: inherit;
}

.vip__sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  color: inherit;
  opacity: 0.72;
}

.vip__cta {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background: #141414;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: #ffffff;
}

.body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 16rpx 32rpx 32rpx;
}

.block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.block__head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.block__title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 39rpx;
  color: #1c1f21;
}

.block__chip {
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(131, 212, 20, 0.18);
  font-size: 22rpx;
  font-weight: 500;
  color: #386b14;
}

.radar-card {
  padding: 12rpx 12rpx 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.radar {
  position: relative;
  height: 380rpx;
}

.radar__canvas {
  width: 100%;
  height: 380rpx;
  /* 原生 canvas 不吃 z-index。抽屉打开时 wxml 里 wx:if 卸掉它 */
}

.radar-label {
  position: absolute;
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  font-weight: 500;
  color: #1c1f21;
  background: #ffffff;
  padding: 0 4rpx;
}

.radar-label__num {
  font-size: 20rpx;
  font-weight: 700;
  color: #47850f;
}

.radar-label--n {
  left: 50%;
  top: 8rpx;
  align-items: center;
  transform: translateX(-50%);
}

.radar-label--ne {
  right: 12rpx;
  top: 86rpx;
}

.radar-label--se {
  right: 12rpx;
  bottom: 86rpx;
}

.radar-label--s {
  left: 50%;
  bottom: 8rpx;
  align-items: center;
  transform: translateX(-50%);
}

.radar-label--sw {
  left: 12rpx;
  bottom: 86rpx;
  align-items: flex-end;
}

.radar-label--nw {
  left: 12rpx;
  top: 86rpx;
  align-items: flex-end;
}

.radar-card__hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: #6b7a73;
}

.career {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.career-row {
  display: flex;
  gap: 10rpx;
}

.career-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.career-card--wide {
  width: 100%;
}

.career-card--pressed {
  opacity: 0.82;
}

.career-card__head {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.career-card__icon {
  width: 56rpx;
  height: 56rpx;
}

.career-card__name {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #1c1f21;
}

.career-card__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 29rpx;
  color: #787e6c;
}

.career-card__link {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 29rpx;
  color: #508c10;
}

/**
 * 2×2 宫格。两行各 flex:1，不要用 calc 算半宽——开发者工具对 rpx 的 calc 经常失效，
 * 格子会变成通栏，图标被拉得巨大。
 */
.services {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.services__row {
  display: flex;
  gap: 10rpx;
}

.service {
  position: relative;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  height: 139rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.service--pressed {
  opacity: 0.82;
}

.service__icon {
  width: 64rpx;
  height: 64rpx;
}

.service__icon--flip {
  transform: scaleX(-1);
}

.service__label {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 31rpx;
  color: #1c1f21;
}

.service__hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

.service__hit::after {
  border: none;
}

/**
 * 退出通栏。设计稿没有。
 * 图标用线框 SVG，不要再塞生成的 3D 门——跟素材板上切出来的粘土图标对不上。
 * 描边色 #1c1f21，跟这一行字一个色。
 */
.logout-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 24rpx;
  color: #1c1f21;
}

.logout-row__icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none'%3E%3Cpath d='M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3' stroke='%231c1f21' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M16 17l5-5-5-5' stroke='%231c1f21' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M21 12H9' stroke='%231c1f21' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 36rpx 36rpx;
}

.logout-row--pressed {
  opacity: 0.82;
}

.tabbar-spacer {
  height: calc(153rpx + env(safe-area-inset-bottom));
}

/* ---------- 更换背景抽屉 401:359 ---------- */

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
}

.sheet__dim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.32);
}

.sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* 底栏是独立一层，页面 z-index 压不住。底部垫上底栏高度，「完成」才露出来，整块也会往上长一截 */
  padding: 32rpx 0 calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 24rpx);
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
}

.sheet__panel--mint {
  background: var(--page-bg);
}

.member-plans {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.member-plan {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  height: 248rpx;
  margin-left: 12rpx;
  padding: 28rpx 12rpx 20rpx;
  overflow: hidden;
  vertical-align: top;
  border: 2rpx solid #e8e8e5;
  border-radius: 20rpx;
  background: #ffffff;
}

.member-plan:first-child {
  margin-left: 32rpx;
}

.member-plan:last-child {
  margin-right: 32rpx;
}

.member-plan.is-active {
  border-color: var(--accent);
  background: #f7fbe8;
}

.member-plan__flag {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  padding: 4rpx 10rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: var(--accent);
  font-size: 16rpx;
  font-weight: 700;
  line-height: 19rpx;
  color: #1a1f16;
}

.member-plan__name {
  margin-top: 36rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 29rpx;
  color: #1f211c;
}

.member-plan__badge {
  margin-top: 10rpx;
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
  background: #f3f3f1;
  font-size: 16rpx;
  line-height: 19rpx;
  color: #73786b;
}

.member-plan.is-active .member-plan__badge {
  background: rgba(131, 212, 20, 0.22);
  color: #3a6b08;
}

.member-plan__price {
  display: flex;
  align-items: flex-end;
  margin-top: 10rpx;
  color: #1f211c;
}

.member-plan__yen {
  margin-bottom: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.member-plan__num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.member-plan__origin {
  margin-top: 10rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  color: #9b9e96;
  text-decoration: line-through;
}

.member-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 0 32rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  color: #73786b;
}

.member-hint__q {
  width: 26rpx;
  height: 26rpx;
  border: 1rpx solid #c8cbc3;
  border-radius: 50%;
  font-size: 18rpx;
  line-height: 24rpx;
  color: #9b9e96;
  text-align: center;
}

.member-pays {
  display: flex;
  gap: 12rpx;
  padding: 0 32rpx;
}

.member-pay {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 68rpx;
  border: 2rpx solid #e8e8e5;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 22rpx;
  color: #1f211c;
}

.member-pay.is-active {
  border-color: var(--accent);
  background: #f7fbe8;
}

.member-pay__mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #ffffff;
  text-align: center;
}

.member-pay__mark--alipay {
  background: #1677ff;
}

/**
 * 微信支付图标来自 Figma 456:413「微信图标 / 96px 主图标」导出。
 * 支付行槽位是 36×36（355:402），1px = 1rpx。圆角已画在图里，不要再裁一层。
 */
.wx-mark {
  flex-shrink: 0;
  display: block;
  width: 36rpx;
  height: 36rpx;
}

.sheet__panel--mint .sheet__done {
  gap: 12rpx;
  margin-top: 32rpx;
}

.member-save {
  font-size: 20rpx;
  font-weight: 500;
  opacity: 0.78;
}

.member-agree {
  margin-top: 12rpx;
  padding: 0 32rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  color: #9b9e96;
  text-align: center;
}

.sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto;
  border-radius: 4rpx;
  background: #d8d8d4;
}

.sheet__title {
  padding: 24rpx 32rpx 0;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 49rpx;
  color: #1c1f21;
}

.sheet__sub {
  padding: 8rpx 32rpx 0;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #737a76;
}

.sheet__label {
  padding: 28rpx 32rpx 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 35rpx;
  color: #1c1f21;
}

.swatches {
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx;
}

.swatch {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  font-size: 20rpx;
  font-weight: 500;
  color: #737a76;
}

.swatch--on {
  font-weight: 700;
  color: #1c1f21;
}

.swatch__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.swatch--on .swatch__dot {
  border-color: #83d414;
}

.swatch__fill {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.swatch__dot--photo {
  background: #ffffff;
}

.swatch__fill--empty {
  background: #e8e8e4;
}

.covers {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 32rpx;
}

.cover-pick {
  width: 162.5rpx;
  height: 156rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.cover-pick__img {
  width: 100%;
  height: 100%;
}

.cover-pick--on {
  box-shadow: 0 0 0 4rpx #83d414;
}

.cover-pick--album {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7faf7;
  border: 2rpx solid #d8d8d4;
  font-size: 22rpx;
  color: #737a76;
}

.cover-pick--solid {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--page-tint);
  border: 2rpx solid #d8d8d4;
  font-size: 22rpx;
  color: #1c1f21;
}

.sheet__done {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 686rpx;
  height: 80rpx;
  margin: 40rpx auto 0;
  border-radius: 24rpx;
  background: #83d414;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 41rpx;
  color: #1c1f21;
}

/**
 * 介绍 / 标签抽屉里的输入。浅薄荷底、16 圆角，对齐资料页 .row__input。
 * 不要 placeholder：标题已经说明这是什么。
 */
.sheet-field {
  width: 686rpx;
  min-height: 160rpx;
  margin: 24rpx auto 0;
  padding: 20rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 16rpx;
  background: #f4f8f4;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
  color: #1c1f21;
}

.sheet-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 24rpx 32rpx 0;
}

.sheet-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border: 1rpx solid #e5ebe5;
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  color: #738078;
}

.sheet-pill--on {
  border-color: var(--accent);
  background: var(--accent);
  color: #1c1f21;
}

.sheet-input {
  width: 686rpx;
  height: 56rpx;
  margin: 16rpx auto 0;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 12rpx;
  background: #f4f8f4;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 56rpx;
  color: #1c1f21;
}

/**
 * 登录抽屉。白卡圆角沿用 .sheet（36）。
 * 主按钮必须是原生 <button open-type="getPhoneNumber">，
 * 普通 view 调不起来微信选号层。未勾协议时换成 view，点了只提示。
 */
.login-agree {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin: 32rpx 32rpx 0;
}

.login-check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
  border: 2rpx solid #d8d8d4;
  border-radius: 8rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  color: transparent;
}

.login-check--on {
  color: #1c1f21;
}

.login-agree__text {
  flex: 1;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #737a76;
}

.login-agree__link {
  color: #2f6fed;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 686rpx;
  height: 80rpx;
  margin: 32rpx auto 0;
  padding: 0;
  border: none;
  border-radius: 24rpx;
  background: var(--accent);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 80rpx;
  color: #1c1f21;
}

.login-btn::after {
  border: none;
}

.login-btn--off {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #d8d8d4;
  color: #737a76;
}

.login-btn--pressed {
  opacity: 0.88;
}

.login-cancel {
  margin: 16rpx 0 8rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #737a76;
  text-align: center;
}

.login-back {
  padding: 20rpx 32rpx 0;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #737a76;
}

.login-doc {
  height: 360rpx;
  margin: 16rpx 32rpx 24rpx;
}

.login-doc__text {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #1c1f21;
}
