<view class="membership">
  <page-nav title="开通会员" />
  <view class="header" style="padding-top:{{statusBarHeight}}px">
    <view class="header__inner">
      <view class="header__wave"></view>
    </view>
  </view>

  <view class="hero-card">
    <view class="vip-mark">
      <view class="vip-mark__hex">VIP</view>
    </view>
    <view class="hero-card__kicker">{{hero.kicker}}</view>
    <view class="hero-card__title">{{hero.title}}</view>
    <view class="hero-card__sub">{{hero.subtitle}}</view>
  </view>

  <view class="section-title">会员权益</view>
  <view class="benefit" wx:for="{{benefits}}" wx:key="key">
    <view class="benefit__index">{{index + 1}}</view>
    <view class="benefit__copy">
      <view class="benefit__name">{{item.title}}</view>
      <view class="benefit__desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="section-title">选择套餐</view>
  <view class="plans">
    <view
      wx:for="{{plans}}"
      wx:key="key"
      class="plan {{activePlan === item.key ? 'is-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSelectPlan"
    >
      <view class="plan__badge" wx:if="{{item.recommended}}">推荐</view>
      <view class="plan__name">{{item.name}}</view>
      <view class="plan__price">
        <text class="plan__yen">¥</text>
        <text class="plan__num">{{item.price}}</text>
      </view>
      <view class="plan__unit">{{item.unit}}</view>
      <view class="plan__hint">{{item.hint}}</view>
    </view>
  </view>

  <view class="checkout-spacer"></view>
  <view class="checkout">
    <view class="checkout__btn" bindtap="onCheckout">立即开通</view>
  </view>
</view>
