/**
 * ============================================================================
 * 关于我们页样式
 * ============================================================================
 * 和「我的资料」一样：吸顶栏 occupy，不再画波浪头、圆形图标。
 */

.info {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.kicker {
  margin-top: 24rpx;
  padding: 0 32rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  text-align: center;
  color: #5c6356;
}

.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 694rpx;
  margin: 14rpx 28rpx 0;
  padding: 28rpx 32rpx 32rpx;
  border: 2rpx solid #cfd2c6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 16rpx rgba(31, 46, 31, 0.12);
}

.card__title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
  color: #1b201d;
}

.card__sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
  color: #5c6356;
}

.qr {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 280rpx;
  margin-top: 16rpx;
  border: 3rpx dashed var(--accent);
  border-radius: 24rpx;
  background: #f7faf3;
}

.qr__hint {
  width: 240rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
  text-align: center;
  color: var(--accent);
  white-space: pre-wrap;
}

.card__account {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 30rpx;
  color: #1b201d;
}

.card__hours {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 25rpx;
  color: #7d8583;
}
