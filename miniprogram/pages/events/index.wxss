/* 数值取自 Figma node 1:206 及其子节点，画板 750px 宽对应 750rpx */

/* 列位于 38/212/386/560，行位于 14/180，等价于左内边距 38 + 列间距 16 + 行间距 12 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  height: var(--grid-height);
  padding: 14rpx 0 0 38rpx;
  background: var(--grid-gradient);
}

.feature {
  position: relative;
  width: 158rpx;
  height: 154rpx;
  /* 设计中每格都做了裁切，图标的负 top 会被裁掉一部分，属于预期效果 */
  overflow: hidden;
}

.feature--pressed {
  opacity: 0.75;
}

/* 七个图标的位置与尺寸各不相同，逐项由 iconStyle 指定 */
.feature__icon {
  position: absolute;
}

.feature__label {
  position: absolute;
  left: 0;
  top: 91rpx;
  width: 100%;
  height: 32rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--text-grid-label);
}

.feed {
  display: flex;
  flex-direction: column;
  padding: 16rpx 26rpx 24rpx;
  border-radius: var(--radius-feed);
  background: var(--feed-gradient);
}

/* 设计稿只画了一张卡片，多卡片时补间距避免阴影相互压叠 */
.feed__card + .feed__card {
  margin-top: 16rpx;
}

.feed__empty {
  padding: 72rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}
