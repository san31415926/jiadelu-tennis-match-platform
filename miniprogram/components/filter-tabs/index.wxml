<view class="filters {{variant === 'capsule' ? 'filters--capsule' : ''}}">
  <view
    wx:for="{{tabs}}"
    wx:key="*this"
    class="filters__item {{active === item ? 'is-active' : ''}}"
    style="{{active === item ? 'background:' + (activeColor || accent) + ';color:' + (activeTextColor || accentText) : ''}}"
    data-tab="{{item}}"
    bindtap="onTap"
  >
    {{item}}
  </view>
</view>
