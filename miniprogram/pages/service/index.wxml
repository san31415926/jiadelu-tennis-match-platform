<view class="info theme-{{theme}}" style="{{themeVars}};background:{{headerGradientDown}}">
  <page-nav title="{{page.title}}" occupy="{{true}}" />

  <view class="kicker">{{page.kicker}}</view>

  <view class="card">
    <view class="card__title">{{page.cardTitle}}</view>
    <view class="card__sub">{{page.cardSub}}</view>
    <button class="contact-btn" style="background:{{accent}};color:{{accentText}}" open-type="contact">{{page.button}}</button>
    <view class="card__hours">{{page.hours}}</view>
  </view>
</view>
