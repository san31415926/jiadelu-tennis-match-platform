<view class="membership">
  <page-nav title="开通会员" variant="plain" occupy="{{true}}" />

  <view class="sheet">
    <view class="sheet__handle"></view>
    <view class="sheet__kicker">一种会员，按时长选择套餐</view>

    <scroll-view class="plans" scroll-x show-scrollbar="{{false}}">
      <view
        wx:for="{{plans}}"
        wx:key="key"
        class="plan {{activePlan === item.key ? 'is-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSelectPlan"
      >
        <view class="plan__flag" wx:if="{{item.recommended}}">推荐</view>
        <view class="plan__name">{{item.name}}</view>
        <view class="plan__badge">{{item.badge}}</view>
        <view class="plan__price">
          <text class="plan__yen">¥</text>
          <text class="plan__num">{{item.price}}</text>
        </view>
        <view class="plan__origin" wx:if="{{item.origin}}">¥ {{item.origin}}</view>
      </view>
    </scroll-view>

    <view class="hint">
      <text>到期 299 元/年自动续费，可随时取消</text>
      <view class="hint__q">?</view>
    </view>

    <view class="pay-title">支付方式</view>
    <view class="pays">
      <view
        wx:for="{{payMethods}}"
        wx:key="key"
        class="pay {{activePay === item.key ? 'is-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSelectPay"
      >
        <view class="pay__mark">{{item.mark}}</view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="checkout-spacer"></view>
  <view class="checkout">
    <view class="checkout__btn" bindtap="onCheckout">
      <text class="checkout__label">{{payLabel}}</text>
      <text class="checkout__save" wx:if="{{saveHint}}">{{saveHint}}</text>
    </view>
    <view class="checkout__agree">开通会员代表同意《会员服务协议》和《自动续费服务规则》</view>
  </view>
</view>
