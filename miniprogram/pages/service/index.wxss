/**
 * ============================================================================
 * 联系客服页样式
 * ============================================================================
 * 和「我的资料」一样：吸顶栏 occupy，不再画波浪头、圆形图标。
 * button 默认有边框和内边距，下面全部清掉，才长得像胶囊。
 */

.info {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.kicker {
  margin-top: 24rpx;
  padding: 0 32rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  text-align: center;
  color: #5c6356;
}

.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 694rpx;
  margin: 14rpx 28rpx 0;
  padding: 32rpx 32rpx 36rpx;
  border: 2rpx solid #cfd2c6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 16rpx rgba(31, 46, 31, 0.12);
}

.card__title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
  color: #1b201d;
}

.card__sub {
  margin-top: 16rpx;
  width: 580rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
  color: #5c6356;
}

.contact-btn {
  width: 630rpx;
  height: 88rpx;
  margin: 16rpx 0 0;
  padding: 0;
  border: none;
  border-radius: 44rpx;
  background: var(--accent);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  color: var(--accent-text);
}

.contact-btn::after {
  border: none;
}

.card__hours {
  margin-top: 16rpx;
  width: 580rpx;
  font-size: 18rpx;
  line-height: 23rpx;
  text-align: center;
  color: #7d8583;
}
