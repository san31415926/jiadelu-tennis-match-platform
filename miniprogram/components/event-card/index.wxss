/**
 * ============================================================================
 * 赛事卡片样式（首页、超级杯、日历三个页面共用）
 * ============================================================================
 * 数值来自 Figma node 180:199（赛事列表 / 参考卡）。
 * 设计稿 1px = 1rpx，下面的 188、210、20 都是稿上的原始标注。
 *
 * 【改这里会影响三个页面】
 * 首页、超级杯、日历都引用这个组件。如果只想改某一个页面的卡片，
 * 不要动这里，去那个页面的 wxss 里给 .feed__card 加规则覆盖。
 *
 * 【卡片内部怎么分配宽度】
 * 外层页面左右各留 26rpx，卡片可用宽 698rpx。
 * 卡片内边距 16×2 + 海报 188 + 间距 14 = 234，剩下约 464rpx 给右侧信息。
 * 海报加宽时，右侧会自动变窄（flex: 1），不用再手写死宽度。
 */

/**
 * 普通卡：白底 + 浅灰描边。推荐卡用 .event-card--featured 换成桃底。
 * 圆角 20 来自稿上 rounded-[20px]，不是全站 --radius-card（28）。
 */
.event-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 16rpx 12rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e5e3;
}

.event-card--featured {
  padding-bottom: 16rpx;
  background: #fff5ed;
  border-color: #fff5ed;
}

.event-card__main {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

/**
 * 左侧海报。overflow: hidden 让圆角裁切照片，也裁切底条两端。
 * 宽高不要只改一个，比例是按 188×210 排的。
 */
.event-card__poster {
  position: relative;
  flex-shrink: 0;
  width: 188rpx;
  height: 210rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.event-card__photo {
  width: 188rpx;
  height: 210rpx;
}

.event-card__status {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  background: #83d414;
  font-size: 16rpx;
  font-weight: 500;
  line-height: 21rpx;
  color: #1a1f16;
}

.event-card__recommend {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  background: #f57a29;
  font-size: 16rpx;
  font-weight: 500;
  line-height: 21rpx;
  color: #ffffff;
}

/**
 * 海报底条。高度 34、半透明黑，贴在海报底部。
 * 用 bottom: 0 而不是稿上的 top: 176，海报高度改了时底条还会粘在底下。
 */
.event-card__slots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 34rpx;
  padding: 0 10rpx;
  background: rgba(0, 0, 0, 0.55);
  font-size: 16rpx;
  font-weight: 500;
  line-height: 34rpx;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.event-card__body {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.event-card__title-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  min-width: 0;
}

.event-card__grade {
  flex-shrink: 0;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  font-size: 16rpx;
  font-weight: 500;
  line-height: 21rpx;
  color: #ffffff;
}

.event-card__grade--orange {
  background: #f57a29;
}

.event-card__grade--green {
  background: #73bf40;
}

.event-card__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 31rpx;
  color: #1f211c;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.event-tag {
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  font-size: 16rpx;
  font-weight: 500;
  line-height: 21rpx;
}

.event-tag--realname {
  background: #ffebb2;
  color: #f57a29;
}

.event-tag--court {
  background: #e8f1ff;
  color: #3373d9;
}

.event-tag--newbie {
  background: #ffe4e8;
  color: #e54d59;
}

.event-card__meta {
  display: flex;
  gap: 8rpx;
  align-items: center;
  min-width: 0;
}

.event-card__meta-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 18rpx;
  line-height: 23rpx;
  color: #73786b;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta-icon {
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

/* 地点：定位针。颜色跟稿上信息文字 #73786b 一致 */
.meta-icon--location {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='22' height='22' viewBox='0 0 22 22'%3E%3Cpath fill='%2373786b' d='M11 2.2c-3.4 0-6.2 2.7-6.2 6.1 0 4.6 6.2 11.5 6.2 11.5s6.2-6.9 6.2-11.5c0-3.4-2.8-6.1-6.2-6.1zm0 8.3a2.2 2.2 0 1 1 0-4.4 2.2 2.2 0 0 1 0 4.4z'/%3E%3C/svg%3E");
}

/* 时间：圆环 + 指针 */
.meta-icon--time {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='22' height='22' viewBox='0 0 22 22'%3E%3Ccircle cx='11' cy='11' r='7.2' fill='none' stroke='%2373786b' stroke-width='1.6'/%3E%3Crect x='10.2' y='5.5' width='1.6' height='6.2' rx='0.8' fill='%2373786b'/%3E%3Crect x='10.2' y='10.4' width='5.4' height='1.6' rx='0.8' fill='%2373786b'/%3E%3C/svg%3E");
}

/**
 * 价格。颜色 #0dadad 是稿上的青绿，不是品牌青柠。
 * margin-top: auto 把它推到信息区底部，跟海报下沿齐平。
 */
.event-card__price {
  align-self: flex-end;
  margin-top: auto;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
  color: #0dadad;
}

.event-card__dots {
  display: flex;
  gap: 6rpx;
  justify-content: center;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d8d8d4;
}

.dot--on {
  background: #83d414;
}

.event-card__divider {
  height: 1rpx;
  background: #ebebe8;
}

/**
 * 场馆行。catchtap 不会冒泡到卡片，所以点这里进俱乐部列表，
 * 不会同时跳赛事详情。chevron 是文字 ›，不是图片。
 */
.event-card__venue {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.event-card__venue-logo {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
}

.event-card__venue-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 20rpx;
  line-height: 26rpx;
  color: #73786b;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-card__chevron {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 36rpx;
  color: #73786b;
}
