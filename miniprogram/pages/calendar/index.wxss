/**
 * ============================================================================
 * 赛事日历页样式
 * ============================================================================
 * 数值来自 Figma node 17:93 及其子节点。
 * 旧绿头、椭圆白浪已经删掉，occupy 吸顶栏。月份条和选中日走主题强调色。
 *
 * 【日历格子的尺寸是算出来的】
 * 日历总宽 686rpx ÷ 7 列 = 98rpx，所以每个格子宽 98rpx。
 * 如果改了总宽，格子宽必须同步改成"总宽÷7"，否则最后一列会掉下去。
 */

.calendar {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: var(--page-bg);
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx 8rpx;
}

.month-controls {
  display: flex;
  align-items: center;
  height: 64rpx;
  color: #0f1408;
}

.month-controls__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 64rpx;
  font-size: 42rpx;
}

.month-controls__label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 270rpx;
  height: 64rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.today-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 50rpx;
  border-radius: 25rpx;
  background: var(--accent);
  font-size: 22rpx;
  color: var(--accent-text);
}

/* ---------- 月视图 ---------- */

.grid {
  padding: 17rpx 0;
  background: var(--page-bg);
}

.grid__inner {
  width: 686rpx;
  margin: 0 auto;
  background: var(--card-bg);
}

.grid__weekdays {
  display: flex;
  height: 42rpx;
  background: var(--card-bg);
}

.grid__weekday {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  height: 42rpx;
  font-size: 20rpx;
  color: #73786e;
}

.grid__week {
  display: flex;
  height: 62rpx;
  margin-top: 1rpx;
}

/**
 * 一个日期格子。
 *
 * 98rpx = 686 ÷ 7，正好七列铺满。里面有三层（都是绝对定位）：
 *   .cell__circle 选中日的绿色圆底，只在选中时出现
 *   .cell__day    日号文字
 *   .cell__dot    有赛事时的绿色小点
 *
 * 圆底写在文字之前，所以文字自然压在圆底上面（靠 DOM 顺序，不用 z-index）。
 */
.cell {
  position: relative;
  width: 98rpx;
  height: 62rpx;
}

/* node 17:176：52x52 的选中圆 */
.cell__circle {
  position: absolute;
  left: 23rpx;
  top: 1rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--accent);
}

.cell__day {
  position: absolute;
  left: 0;
  top: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  height: 52rpx;
  font-size: 26rpx;
  color: #1f2114;
}

/* 非本月日期的浅灰是按定稿图目视取的，Figma 未导出该状态 */
.cell__day--muted {
  color: #b3b8a8;
}

/* node 17:137：10x10 的赛事标记点 */
.cell__dot {
  position: absolute;
  left: 44rpx;
  top: 47rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent);
}

/* ---------- 选中日期的赛事 ---------- */

.day-heading {
  display: flex;
  align-items: center;
  width: 680rpx;
  height: 48rpx;
  margin: 0 auto;
  padding: 0 38rpx;
  border: 2rpx solid #cfd2c6;
  border-radius: 24rpx;
  background: #ffffff;
}

.day-heading__text {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #1f2114;
}

.day-heading__divider {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: #e5eec9;
}

.feed {
  display: flex;
  flex-direction: column;
  padding: 16rpx 26rpx 24rpx;
  border-radius: var(--radius-feed);
  background: var(--feed-gradient);
}

.feed__card + .feed__card {
  margin-top: 24rpx;
}

.feed__empty {
  padding: 72rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}
