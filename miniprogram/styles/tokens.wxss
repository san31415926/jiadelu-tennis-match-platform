/**
 * ============================================================================
 * 设计 token —— 全站视觉的总开关
 * ============================================================================
 *
 * 【这个文件是干什么的】
 * 整个小程序的颜色、圆角、阴影、关键高度都定义在这里，各个页面只写
 * var(--变量名) 去引用。所以想全站统一改配色或圆角，只动这一个文件就够了，
 * 不用去七个页面里一个个找。
 *
 * 【取值来源】
 * 全部来自 Figma 文件「网球赛事总结」(nzKWauHC37fyjpAtA3rjfd) 的节点标注，
 * 不是看图估的。每条后面标了对应的 Figma 节点号，方便回去核对。
 *
 * 【关于 rpx 这个单位】
 * rpx 是小程序的自适应单位，规则是：屏幕宽度永远等于 750rpx。
 * 因为设计稿画板宽度正好是 750px，所以设计稿上量到的 1px 直接写成 1rpx 即可，
 * 不需要任何换算。屏幕越宽，1rpx 换算出的实际尺寸越大，所以布局能自动适配
 * 各种手机。在 iPhone 上大约 1rpx = 0.5pt。
 *
 * 【怎么改】
 * 改颜色：直接替换十六进制色值，比如把 --brand-lime 从 #83d414 换成 #6cbf0a
 *        会让全站所有"选中态绿色"一起变深。
 * 改圆角：数值越大越圆。--radius-card 从 28rpx 调到 0 会让赛事卡片变成方角。
 * 改阴影：格式是 "横向偏移 纵向偏移 模糊半径 颜色"，把模糊半径调大会更朦胧。
 *
 * 【注意】
 * 这些变量定义在 page 选择器上，所以页面和组件里都能用。但如果你在
 * app.wxss 的 page 之外的地方引用，可能取不到值。
 */
page {
  /* --------------------------------------------------------------------------
   * 一、头部渐变
   * ------------------------------------------------------------------------ */

  /* 首页与超级杯页顶部那条绿色横幅（Figma node 1:208）。
     90deg 表示从左到右；三个百分比是色标位置。
     想让绿色整体更深 → 把三个颜色都换暗一点；
     想改成从上往下渐变 → 把 90deg 改成 180deg；
     想去掉中间过渡色 → 删掉中间那个 #bfe63b 48%。 */
  --header-gradient: linear-gradient(90deg, #d4f34a 0%, #bfe63b 48%, #7ebb27 100%);

  /* --------------------------------------------------------------------------
   * 二、品牌绿系列（按用途区分，不要混用）
   * ------------------------------------------------------------------------ */

  /* 筛选 Tab 选中时的底色，也是全站主色。Figma 里就叫 tennis-color-brand-lime。
     改它会影响：首页/超级杯的状态筛选选中态、俱乐部筛选选中态。 */
  --brand-lime: #83d414;

  /* 报名按钮那个更深的绿（Figma node 1:293）。
     它比 --brand-lime 深，是为了在白底卡片上更突出。
     改它会影响：所有赛事卡片右下角的「立即报名 / 团队报名」按钮。 */
  --brand-green-deep: #54b50a;

  /* 底栏当前 Tab 图标背后那圈淡绿光晕（Figma node 1:297）。
     调浅会让选中态更含蓄，调深会更醒目。 */
  --brand-halo: #e6ffb0;

  /* 底栏当前 Tab 的文字颜色。未选中的文字色见 --text-tabbar-idle。 */
  --brand-green-text: #59850a;

  /* --------------------------------------------------------------------------
   * 三、背景色
   * ------------------------------------------------------------------------ */

  /* 页面底色，同时也是头部波浪的填充色——两者必须一致，
     否则波浪会和下方页面之间出现一条色差边。改这个记得同步改
     app.wxss 里 .header__wave 那段 SVG 里的 fill 值。 */
  --page-bg: #fbfff4;

  /* 首页七宫格区域的背景（Figma node 1:239）。
     179.4deg 是从上往下略微倾斜，三段色标做出"中间白、上下泛绿"的效果。
     想让宫格区变纯白 → 三个颜色都改成 #ffffff。 */
  --grid-gradient: linear-gradient(
    179.4deg,
    #f9ffeb 6.58%,
    #ffffff 45.23%,
    #f2ffd6 97.05%
  );

  /* 赛事列表区的背景（Figma node 1:270），从浅绿渐变到浅灰。
     首页、超级杯、日历三个页面的卡片区都用它。 */
  --feed-gradient: linear-gradient(180deg, #f2ffd6 0%, #f5f8f5 100%);

  /* 卡片、列表行、筛选条的白底。Figma 里叫 tennis-color-surface-card。 */
  --card-bg: #ffffff;

  /* --------------------------------------------------------------------------
   * 四、文字颜色（按层级从深到浅）
   * ------------------------------------------------------------------------ */

  /* 页面顶部大标题，如「LTJIMMY赛事」「超级杯」。 */
  --text-nav-title: #263312;

  /* 轮播主标题，如「广佛俱乐部联名赛」。 */
  --text-banner-title: #14210a;

  /* 轮播副标题，如「球员精彩瞬间 · 点击查看」。比主标题浅，形成层次。 */
  --text-banner-sub: #50662a;

  /* 宫格图标下方的文字，如「球员排行」「赛事日历」。 */
  --text-grid-label: #333b2e;

  /* 筛选 Tab 选中时的文字色（配合 --brand-lime 底色）。 */
  --text-tab-active: #10140e;

  /* 次要信息的统一灰色：筛选 Tab 未选中文字、赛事卡片的地点/时间/人数、
     各种空状态提示。改它会一次影响很多地方，调深会让整体更"重"。 */
  --text-muted: #7d8583;

  /* 赛事卡片标题，如「7.0混双评级赛」。 */
  --text-card-title: #1b201d;

  /* 底栏未选中 Tab 的文字色。 */
  --text-tabbar-idle: #6b7566;

  /* 深色底上的白字，如报名按钮里的文字。 */
  --text-inverse: #ffffff;

  /* --------------------------------------------------------------------------
   * 五、轮播指示点
   * ------------------------------------------------------------------------ */

  /* 当前那一页的点（深色）。 */
  --dot-active: #294308;

  /* 其余的点。带 0.42 透明度，所以在不同深浅的渐变背景上都不刺眼。 */
  --dot-idle: rgba(83, 119, 36, 0.42);

  /* --------------------------------------------------------------------------
   * 六、圆角（数值越大越圆，改成 0 就是直角）
   * ------------------------------------------------------------------------ */

  /* 赛事列表区外框的大圆角，视觉上把列表"托起来"。 */
  --radius-feed: 40rpx;

  /* 赛事卡片。 */
  --radius-card: 28rpx;

  /* 卡片里那张球场照片。 */
  --radius-photo: 22rpx;

  /* 筛选 Tab 的药丸形状。它等于 Tab 高度(46rpx)的一半，
     所以看起来是完美的半圆端。如果你改了 Tab 高度，这里也要跟着改成新高度的一半。 */
  --radius-tab: 23rpx;

  /* 报名按钮。同理，等于按钮高度(54rpx)的一半。 */
  --radius-button: 27rpx;

  /* --------------------------------------------------------------------------
   * 七、阴影
   * ------------------------------------------------------------------------ */

  /* 赛事卡片的投影（Figma node 1:272）。
     四个值依次是：横向偏移 / 纵向偏移 / 模糊半径 / 颜色。
     纵向偏移调大会让卡片看起来"浮"得更高；
     模糊半径调大会更柔和；把透明度 0.12 调大会更明显。 */
  --shadow-card: 0 10rpx 12rpx rgba(31, 46, 31, 0.12);

  /* --------------------------------------------------------------------------
   * 八、关键高度（这些数值和设计稿严格对应，改动会影响整页布局）
   * ------------------------------------------------------------------------ */

  /* 首页/超级杯头部渐变区的高度，不含手机状态栏（Figma node 1:208）。
     状态栏高度由 JS 在运行时测量后以 padding-top 形式追加，
     所以真机上头部总高 = 状态栏 + 321rpx。 */
  --header-height: 321rpx;

  /* 七宫格区的高度（Figma node 1:239）。
     宫格是两行、每行 154rpx，加上内外边距刚好 350rpx。
     如果你要加第三行入口，这里必须同步加大，否则第三行会被裁掉。 */
  --grid-height: 350rpx;

  /* 状态筛选条的高度。 */
  --filter-height: 46rpx;

  /* 自定义底栏的高度，不含手机底部安全区（Figma node 1:295）。
     页面底部靠 .tabbar-spacer 撑出这么高的空白，避免内容被底栏压住。 */
  --tabbar-height: 153rpx;

  /* 底栏未选中图标的不透明度。设计里就是 52%，
     所以未选中的图标看起来是"褪色"的，而不是换了一张灰色图片。
     调到 1 会让三个图标一样鲜艳，选中态就只能靠光晕和文字色区分了。 */
  --tabbar-icon-idle-opacity: 0.52;
}
