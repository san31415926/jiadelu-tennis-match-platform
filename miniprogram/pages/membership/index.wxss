/**
 * ============================================================================
 * 会员开通页样式 —— 视觉刷新草稿 V5
 * ============================================================================
 *
 * 数值来自 Figma node 355:361（Sheet / Checkout），画板 750×740，
 * 是贴在「我的」底下的结算抽屉，不是铺满屏幕的一页。
 * 设计稿 1px = 1rpx。
 *
 * 支付按钮跟在支付方式下面，不要 position:fixed 钉屏幕底，否则中间会空一大截。
 * 想改开通按钮颜色 → 改 .checkout__btn 的 background
 * 想改选中套餐描边 → 改 .plan.is-active 的 border-color
 */

.membership {
  min-height: 100vh;
  background: transparent;
}

.membership__dim {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9;
  background: rgba(0, 0, 0, 0.32);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--page-bg);
}

.sheet__handle {
  width: 77rpx;
  height: 8rpx;
  margin: 0 auto;
  border-radius: 4rpx;
  background: #d8d8d4;
}

.sheet__back {
  padding: 16rpx 32rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 36rpx;
  color: #1c1f21;
}

.sheet__title {
  padding: 8rpx 32rpx 0;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 49rpx;
  color: #1c1f21;
}

.sheet__kicker {
  padding: 8rpx 32rpx 0;
  font-size: 22rpx;
  line-height: 26rpx;
  color: #73786b;
}

.plans {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.plan {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  height: 248rpx;
  margin-left: 12rpx;
  padding: 28rpx 12rpx 20rpx;
  overflow: hidden;
  vertical-align: top;
  border: 2rpx solid #e8e8e5;
  border-radius: 20rpx;
  background: #ffffff;
}

.plan:first-child {
  margin-left: 32rpx;
}

.plan:last-child {
  margin-right: 32rpx;
}

.plan.is-active {
  border-color: var(--accent);
  background: #f7fbe8;
}

.plan__flag {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  padding: 4rpx 10rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: var(--accent);
  font-size: 16rpx;
  font-weight: 700;
  line-height: 19rpx;
  color: #1a1f16;
}

.plan__name {
  margin-top: 36rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 29rpx;
  color: #1f211c;
}

.plan__badge {
  margin-top: 10rpx;
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
  background: #f3f3f1;
  font-size: 16rpx;
  line-height: 19rpx;
  color: #73786b;
}

.plan.is-active .plan__badge {
  background: rgba(131, 212, 20, 0.22);
  color: #3a6b08;
}

.plan__price {
  display: flex;
  align-items: flex-end;
  margin-top: 10rpx;
  color: #1f211c;
}

.plan.is-active .plan__price {
  color: #1a1f16;
}

.plan__yen {
  margin-bottom: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.plan__num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.plan__origin {
  margin-top: 10rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  color: #9b9e96;
  text-decoration: line-through;
}

.hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 0 32rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  color: #73786b;
}

.hint__q {
  width: 26rpx;
  height: 26rpx;
  border: 1rpx solid #c8cbc3;
  border-radius: 50%;
  font-size: 18rpx;
  line-height: 24rpx;
  color: #9b9e96;
  text-align: center;
}

.pay-title {
  margin-top: 16rpx;
  padding: 8rpx 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 31rpx;
  color: #1f211c;
}

.pays {
  display: flex;
  gap: 12rpx;
  padding: 0 32rpx;
}

.pay {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 68rpx;
  border: 2rpx solid #e8e8e5;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 22rpx;
  color: #1f211c;
}

.pay.is-active {
  border-color: var(--accent);
  background: #f7fbe8;
}

.pay__mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #07c160;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #ffffff;
  text-align: center;
}

.pay:last-child .pay__mark {
  background: #1677ff;
}

.checkout {
  padding: 32rpx 32rpx 0;
}

.checkout__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--accent);
}

.checkout__label {
  font-size: 30rpx;
  font-weight: 700;
  color: inherit;
}

.checkout__save {
  font-size: 20rpx;
  color: inherit;
  opacity: 0.78;
}

.checkout__agree {
  margin-top: 12rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  color: #9b9e96;
  text-align: center;
}
