<view class="rewards theme-{{theme}}" style="{{themeVars}}">
  <page-nav title="积分兑换" variant="plain" occupy="{{true}}" />

  <!-- 顶部运营提示，旧版黄条。想改字去 mock/rewards.ts 的 NOTICE -->
  <view class="notice">{{notice}}</view>

  <image
    class="poster"
    src="{{poster}}"
    mode="widthFix"
    bindtap="onPreviewPoster"
    show-menu-by-longpress
  />
</view>
