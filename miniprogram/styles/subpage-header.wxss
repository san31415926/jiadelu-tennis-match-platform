/**
 * ============================================================================
 * 二级页共用头部：青柠/金色渐变 + 波浪 + 网球
 * ============================================================================
 * 我的资料 / 商务合作 / 关于我们 / 联系客服 共用。
 * 头部高度 300rpx，波浪 105rpx 贴在底部（终稿 node 64:378）。
 *
 * 返回和标题在 components/page-nav，不写在这一层，否则会跟着滚走。
 *
 * 关于我们是金色头，给 .sub-header 加 --gold。
 * 波浪 fill 必须和页面底色一致，否则接头会有一条色差。
 */

.sub-header {
  position: relative;
  background: linear-gradient(180deg, #abe514 0%, #c7f038 62%, #f0fab8 100%);
}

.sub-header--gold {
  background: linear-gradient(180deg, #edc71f 0%, #f7e052 62%, #fff5c7 100%);
}

.sub-header__inner {
  position: relative;
  height: 300rpx;
  overflow: hidden;
}

.sub-header__wave {
  position: absolute;
  left: 0;
  top: 195rpx;
  width: 100%;
  height: 105rpx;
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='750' height='105.289' viewBox='0 0 750 105.289' preserveAspectRatio='none'%3E%3Cpath d='M0 51.3173C92 15.0413 166 78.7455 263 62.8194C343 49.5477 373 24.7739 448 49.5477C546 80.515 628 31.8521 750 0V105.289H0V51.3173Z' fill='%23F0FFD5'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-size: 100% 100%;
  pointer-events: none;
}

.sub-header--gold .sub-header__wave {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='750' height='105.289' viewBox='0 0 750 105.289' preserveAspectRatio='none'%3E%3Cpath d='M0 51.3173C92 15.0413 166 78.7455 263 62.8194C343 49.5477 373 24.7739 448 49.5477C546 80.515 628 31.8521 750 0V105.289H0V51.3173Z' fill='%23FFF9E8'/%3E%3C/svg%3E");
}

.sub-header__ball {
  position: absolute;
  left: 628rpx;
  top: 84rpx;
  z-index: 1;
  width: 96rpx;
  height: 96rpx;
}
