/**
 * ============================================================================
 * 会员开通页样式
 * ============================================================================
 *
 * 没有终稿画板，这一版是按「我的」页金色横幅 + 全站青柠绿自己排的，
 * 给你检查。头部结构仿球员排行（绿头 + 波浪），下面权益和套餐是流式。
 *
 * 想改金色 → 搜 #c4a35a / #f6e7b8
 * 想改开通按钮颜色 → 改 .checkout__btn 的 background
 */

.membership {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: #f7faec;
}

.header {
  position: relative;
  background: linear-gradient(180deg, #abe514 0%, #c7f038 62%, #f0fab8 100%);
}

.header__inner {
  height: 168rpx;
}

.header__wave {
  top: 70rpx;
  height: 105rpx;
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='750' height='105' viewBox='0 0 750 105' preserveAspectRatio='none'%3E%3Cpath d='M0 0C125 70 235 70 350 30C500 -24 585 75 750 8V105H0V0Z' fill='%23F7FAEC'/%3E%3C/svg%3E");
}

.hero-card {
  position: relative;
  z-index: 2;
  margin: -36rpx 28rpx 0;
  padding: 36rpx 32rpx 40rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #3a3428 0%, #1f1c16 100%);
  box-shadow: 0 12rpx 24rpx rgba(41, 56, 20, 0.16);
}

.vip-mark {
  display: flex;
  margin-bottom: 20rpx;
}

.vip-mark__hex {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 76rpx;
  border: 3rpx solid #e8c56b;
  color: #e8c56b;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
}

.hero-card__kicker {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #e8c56b;
}

.hero-card__title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
  color: #fff8e0;
}

.hero-card__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: rgba(255, 248, 224, 0.72);
}

.section-title {
  margin: 36rpx 32rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2114;
}

.benefit {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  margin: 0 28rpx 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fcfcfb;
  box-shadow: 0 4rpx 10rpx rgba(38, 56, 20, 0.08);
}

.benefit__index {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #e8f59e;
  color: #548005;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.benefit__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2114;
}

.benefit__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #6b7059;
}

.plans {
  display: flex;
  gap: 16rpx;
  margin: 0 28rpx;
}

.plan {
  position: relative;
  flex: 1;
  padding: 28rpx 20rpx 24rpx;
  border: 3rpx solid transparent;
  border-radius: 24rpx;
  background: #fcfcfb;
  box-shadow: 0 4rpx 10rpx rgba(38, 56, 20, 0.08);
}

.plan.is-active {
  border-color: #c4a35a;
  background: #fffaf0;
}

.plan__badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 14rpx;
  border-radius: 0 20rpx 0 16rpx;
  background: #c4a35a;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.plan__name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2114;
}

.plan__price {
  display: flex;
  align-items: flex-end;
  margin-top: 12rpx;
  color: #c4a35a;
}

.plan__yen {
  margin-bottom: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.plan__num {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 60rpx;
}

.plan__unit,
.plan__hint {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6b7059;
}

.checkout-spacer {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.checkout {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #f7faec;
}

.checkout__btn {
  height: 88rpx;
  border-radius: 44rpx;
  background: #4ec6c8;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}
