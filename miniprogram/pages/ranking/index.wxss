/**
 * ============================================================================
 * 球员排行页样式
 * ============================================================================
 * 数值来自 Figma node 15:3 及其子节点。
 * 旧绿波浪头已经删掉，occupy 吸顶栏。城市榜 / 指标筛选走主题强调色。
 *
 * 【这一页的三种布局方式，各有原因】
 *   筛选条   流式 —— occupy 之后不再叠在装饰头上
 *   领奖台   绝对定位 —— 每个名次是「台座 + 金圈」合成切图
 *   下方列表 流式布局 —— 行数会随展开/收起变化
 *
 * 「查看全部」跟俱乐部榜同一套：顶部分割线 + 灰字 + 强调色箭头，不要绿色药丸。
 *
 * 【领奖台的遮挡关系靠 DOM 顺序，不是 z-index】
 * 头像写在合成切图之后，才能盖住金圈中间的白色圆心。
 */

.ranking {
  min-height: 100vh;
  background: var(--page-bg);
}

.rank-tools {
  padding: 16rpx 40rpx 24rpx;
}

.scope-tabs {
  display: flex;
  gap: 12rpx;
  height: 58rpx;
}

.scope-tabs__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border: 2rpx solid #cfd2c6;
  border-radius: 29rpx;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  color: #3d4436;
}

.scope-tabs__item.is-active {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--accent-text);
}

.metric-tabs {
  display: flex;
  gap: 46rpx;
  margin-top: 20rpx;
}

.metric-tabs__item {
  position: relative;
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #6b7059;
}

.metric-tabs__item.is-active {
  color: #1f2114;
}

.metric-tabs__underline {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 2.5rpx;
  background: var(--accent);
}

/* ---------- 领奖台 ---------- */

.podium {
  position: relative;
  height: 454rpx;
  background: var(--page-bg);
}

/**
 * 装饰用的金色碎片。
 *
 * 四个位置用的是同一张图片（只下载了一份，省体积），靠不同的 left/top 和
 * opacity 摆出散落感。想让画面更干净就把 opacity 调低，或者直接在
 * index.wxml 里删掉几个 .podium__confetti 元素。
 */
.podium__confetti {
  position: absolute;
  width: 150rpx;
  height: 210rpx;
}

.podium__confetti--1 {
  left: 42rpx;
  top: 8rpx;
  opacity: 0.45;
}

.podium__confetti--2 {
  left: 245rpx;
  top: 19rpx;
  opacity: 0.45;
}

.podium__confetti--3 {
  left: 444rpx;
  top: 19rpx;
  opacity: 0.45;
}

.podium__confetti--4 {
  left: 575rpx;
  top: 0;
  opacity: 0.38;
}

/**
 * 一座台 + 一个圈的合成切图。
 *
 * 三个盒子的宽高比必须和 PNG 一致（520×672 / 520×678 / 520×627），
 * 这样 aspectFit 不会留白，头像用百分比定位才能对准金圈圆心。
 * 三座台底边对齐在 359rpx，文字从 369rpx 开始，中间留 10rpx。
 *
 * 圆心百分比来自 tools/measure-podium-circles.cjs 对切图的实测，
 * 不要在开发者工具里拖头像——拖完会写成内联样式，把对齐冲掉。
 */
.podium__unit {
  position: absolute;
}

.podium__unit--first {
  left: 255rpx;
  top: 48rpx;
  width: 240rpx;
  height: 310rpx;
}

.podium__unit--second {
  left: 48rpx;
  top: 72rpx;
  width: 220rpx;
  height: 287rpx;
}

.podium__unit--third {
  left: 482rpx;
  top: 94rpx;
  width: 220rpx;
  height: 265rpx;
}

.podium__unit-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

/**
 * 头像从金圈的透明圆孔里露出来。
 *
 * left/top/宽高都是相对切图盒子的百分比，数字来自实测圆心：
 *   冠军 520×672，白圆 (133,25) 259×264
 *   亚军 520×678，白圆 (112,26) 300×312
 *   季军 520×627，白圆 (114,24) 293×302
 * 改切图之后要重新跑测量脚本，再改这里。
 */
.podium__unit-avatar {
  position: absolute;
  z-index: 0;
  left: 21.54%;
  top: 4.72%;
  width: 57.69%;
  height: 44.25%;
  border-radius: 50%;
}

.podium__unit-avatar--first {
  left: 25.58%;
  top: 4.09%;
  width: 49.81%;
  height: 38.54%;
}

.podium__unit--third .podium__unit-avatar {
  left: 21.92%;
  top: 4.55%;
  width: 56.35%;
  height: 46.73%;
}

/**
 * 领奖台下方的三列文字（昵称、俱乐部、分数）。
 *
 * 三列的 left 和 width 各不相同，因为要和上方三个台座的中心对齐——
 * 冠军台在正中且更宽，亚军季军台偏两侧。
 * 每列内部用 text-align: center 让文字在该列里居中。
 *
 * 想调整某一列的水平位置，改对应 --second / --first / --third 的 left。
 * 判断有没有对齐，看文字中心是否在台座数字（2、1、3）的正下方。
 */
.podium__col {
  position: absolute;
  top: 369rpx;
  text-align: center;
}

.podium__col--second {
  left: 48rpx;
  width: 220rpx;
}

.podium__col--first {
  left: 255rpx;
  width: 240rpx;
}

.podium__col--third {
  left: 482rpx;
  width: 220rpx;
}

.podium__name {
  height: 34rpx;
  font-size: 25rpx;
  line-height: 34rpx;
  color: #1f2114;
}

/* 冠亚季军中，第一、三名的昵称在设计中是加粗的 */
.podium__name--first {
  font-weight: 700;
}

.podium__club {
  height: 28rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #6b7059;
}

.podium__score {
  height: 42rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
  color: #1f2114;
}

.podium__score--first {
  height: 48rpx;
  font-size: 38rpx;
  line-height: 48rpx;
}

/* ---------- 4 名之后的列表 ---------- */

.list {
  margin: 34rpx 30rpx 0;
  width: 690rpx;
  overflow: hidden;
}

.list__row {
  display: flex;
  align-items: center;
  height: 94rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid #dbdecc;
}

.list__rank {
  width: 86rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2114;
}

.list__avatar-slot {
  /**
   * 金框头像组件的占位。组件自己是 86×86，比原来的 70 圆头像略大，
   * 仍能放进 94rpx 高的行。不要再给这里设宽高，会把圈裁掉。
   */
  flex-shrink: 0;
  margin-left: 19rpx;
}

.list__detail {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.list__detail-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 30rpx;
}

.list__nickname {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2114;
}

.list__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 29rpx;
  border-radius: 16rpx;
  background: var(--accent);
  font-size: 18rpx;
  font-weight: 600;
  color: var(--accent-text);
}

.list__club {
  margin-top: 5rpx;
  overflow: hidden;
  font-size: 17rpx;
  line-height: 24rpx;
  color: #6b7059;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.list__score {
  width: 150rpx;
  padding-right: 24rpx;
  text-align: right;
  font-size: 32rpx;
  color: #1f2114;
}

.list__empty {
  padding: 72rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #6b7059;
}

/* ---------- 展开与我的排名 ---------- */

/**
 * 跟俱乐部榜 V5 同一套：顶部分割线 + 灰字 + 青绿箭头，
 * 不是绿色药丸。收起态文案换成「收起」。
 */
.show-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 690rpx;
  height: 64rpx;
  margin: 8rpx 30rpx 0;
  padding-top: 16rpx;
  border-top: 1rpx solid #e5e8e0;
  font-size: 24rpx;
  font-weight: 500;
  color: #101214;
}

.show-more__arrow {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent);
}

/**
 * 为底部固定的「我的排名」卡片留出空间。
 *
 * 那张卡片是 fixed 悬浮的，不占文档流，所以要放一个占位块把内容顶上去，
 * 否则展开列表滚到底时最后一行会被卡片盖住。
 * 高度 = 卡片高 94 + 上下留白 40 = 134rpx，再加手机底部安全区。
 */
.my-rank-spacer {
  height: calc(134rpx + env(safe-area-inset-bottom));
}

.my-rank {
  position: fixed;
  left: 42rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  width: 666rpx;
  height: 94rpx;
  padding: 0 21rpx;
  border: 1rpx solid #e0e5d6;
  border-radius: 32rpx;
  background: var(--card-bg);
  box-shadow: 0 4rpx 10rpx rgba(51, 64, 31, 0.12);
}

.my-rank--pressed {
  opacity: 0.72;
}

.my-rank__trophy {
  flex-shrink: 0;
  width: 70rpx;
  height: 64rpx;
}

.my-rank__summary {
  flex: 1;
  margin-left: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1f2114;
}

.my-rank__action {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
}

.my-rank__cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-left: 20rpx;
  border-radius: 18rpx;
  background: var(--accent);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent-text);
}
