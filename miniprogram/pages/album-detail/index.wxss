/**
 * ============================================================================
 * 相册详情页样式
 * ============================================================================
 * 数值来自草稿 Figma「相册详情 / Prototype Screen / Editable」。
 * 旧绿头、相机、椭圆白浪已经删掉，occupy 吸顶栏。
 *
 * 【照片格子怎么算】
 * 屏宽 750，左右各留 30，中间两条缝各 16：
 *   (750 - 30×2 - 16×2) ÷ 3 = 218
 * 高度按设计 146。改了边距或间距，宽高要一起重算，否则最后一列会掉下去。
 */

.album {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: var(--page-bg);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 40rpx 28rpx;
}

.hero__title {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  line-height: 42rpx;
}

.hero__title-part {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f1408;
}

.hero__title-part--brand {
  color: var(--accent);
}

.hero__meta {
  margin-top: 12rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #6b7066;
}

.hero__chip {
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 18rpx;
  background: var(--accent);
  font-size: 16rpx;
  font-weight: 700;
  color: var(--accent-text);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 30rpx 20rpx;
}

.grid__photo {
  width: 218rpx;
  height: 146rpx;
  border-radius: var(--radius-card);
}