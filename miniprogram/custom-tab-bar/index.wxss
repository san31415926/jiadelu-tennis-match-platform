/* 底栏几何取自 Figma node 1:295：整条 153rpx，三项各 250rpx */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: calc(153rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
}

.tabbar__item {
  position: relative;
  width: 250rpx;
  height: 153rpx;
}

/* 选中态椭圆光晕，node 1:297：81x76，在 250rpx 内居中 */
.tabbar__halo {
  position: absolute;
  left: 85rpx;
  top: 18rpx;
  width: 81rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e6ffb0;
}

/* 三个图标的位置与尺寸各不相同，由 iconStyle 逐项指定 */
.tabbar__icon {
  position: absolute;
}

.tabbar__label {
  position: absolute;
  left: 0;
  top: 87rpx;
  width: 100%;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #6b7566;
}

.tabbar__label.is-active {
  font-weight: 600;
  color: #59850a;
}
