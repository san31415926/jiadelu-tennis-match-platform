<view class="club-home {{fromSuperCup ? 'club-home--super' : ''}} theme-{{theme}}" style="{{themeVars}}">
  <page-nav title="俱乐部主页" occupy="{{true}}" />
  <view wx:if="{{fromSuperCup}}" class="canvas-strip" style="background:{{headerGradientDown}}">
    <image
      class="canvas-strip__pavilion"
      src="/assets/images/club/header-pavilion.png"
      mode="aspectFit"
    />
  </view>

  <view class="hero">
    <gold-avatar src="{{club.logo}}" size="club" />
    <view class="hero__name">{{club.name}}</view>
    <view class="hero__pills">
      <view class="pill">{{club.city}}</view>
      <view class="pill pill--lime" style="background:{{accent}};color:{{accentText}}" wx:if="{{club.recruiting}}">招新中</view>
    </view>
  </view>

  <view class="league-note">
    联赛权益：有效选手年费可转会、累计身价。加入第一家俱乐部不需要年费。年费不是免单站报名费。
  </view>

  <view class="stats {{fromSuperCup ? 'stats--quad' : ''}}">
    <block wx:for="{{stats}}" wx:key="label">
      <view class="stats__divider" wx:if="{{index > 0}}"></view>
      <view class="stats__col">
        <view class="stats__value {{item.lime ? 'stats__value--lime' : ''}}" style="{{item.lime ? 'color:' + accent : ''}}">{{item.value}}</view>
        <view class="stats__label">{{item.label}}</view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section__title">俱乐部成员</view>
    <view class="section__count">{{shownLabel}}</view>
  </view>

  <view class="list">
    <view class="row" wx:for="{{members}}" wx:key="id">
      <gold-avatar src="{{item.avatar}}" size="member" />
      <view class="row__info">
        <view class="row__name-line">
          <text class="row__name">{{item.nickname}}</text>
          <view class="row__captain" style="background:{{accent}};color:{{accentText}}" wx:if="{{item.captain}}">队长</view>
        </view>
        <view class="row__join">{{item.joinedAt}}</view>
      </view>
      <view class="row__power">
        <view class="row__power-value">{{item.power}}</view>
        <view class="row__power-label">战力</view>
      </view>
    </view>
  </view>

  <view class="cta-spacer"></view>
  <view class="cta">
    <view
      class="cta__btn {{club.joined ? 'cta__btn--joined' : ''}}"
      style="{{club.joined ? '' : 'background:' + accent + ';color:' + accentText}}"
      bindtap="onJoin"
    >{{club.joined ? '已加入' : '申请加入'}}</view>
  </view>
</view>
