/**
 * ============================================================================
 * 我的页样式 —— 视觉刷新草稿 V5
 * ============================================================================
 * 数值来自 Figma node 302:103（薄荷资料头）和 401:359（更换背景抽屉）。
 * 设计稿 1px = 1rpx。
 *
 * 【这一页的块】
 *   1. 薄荷霜化头图：封面模糊 + 半透明色罩，头像 120，四列数据
 *   2. VIP 条 #66c4b4
 *   3. 战力图白卡 + canvas 雷达
 *   4. 我的生涯两列 + 参赛记录通栏
 *   5. 更多服务三列
 *   6. 更换背景底部抽屉
 *
 * 旧绿波浪头、金圈领奖台、七项菜单列表已经删掉。
 * 换主题只改 .profile--* 的霜化色，封面图仍是 profile.cover。
 */

.profile {
  min-height: 100vh;
  background: #f0fcf7;
}

.profile--mint {
  --frost: rgba(184, 237, 220, 0.82);
  --fade-end: #f0fcf7;
  --page-tint: #b8eddc;
}

.profile--lime {
  --frost: rgba(212, 243, 74, 0.72);
  --fade-end: #f7fbe8;
  --page-tint: #d4f34a;
}

.profile--gold {
  --frost: rgba(226, 177, 90, 0.55);
  --fade-end: #fbf4e4;
  --page-tint: #e2b15a;
}

.profile--sky {
  --frost: rgba(110, 180, 224, 0.58);
  --fade-end: #eef7fc;
  --page-tint: #6eb4e0;
}

.profile--dusk {
  --frost: rgba(224, 138, 170, 0.5);
  --fade-end: #fceef4;
  --page-tint: #e08aaa;
}

.profile--photo {
  --frost: rgba(184, 237, 220, 0.18);
  --fade-end: #f0fcf7;
  --page-tint: #b8eddc;
}

.hero {
  position: relative;
  overflow: hidden;
  background: var(--page-tint);
}

.hero__cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 1120rpx;
  filter: blur(17px);
  transform: scale(1.08);
}

.hero__frost {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 1120rpx;
  background: var(--frost);
}

.hero__fade {
  position: absolute;
  left: 0;
  right: 0;
  top: 420rpx;
  height: 280rpx;
  background: linear-gradient(180deg, rgba(184, 237, 220, 0) 0%, var(--fade-end) 100%);
}

.hero__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  padding: 28rpx 32rpx 20rpx;
}

.identity {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.identity__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #ffffff;
}

.identity__info {
  flex: 1;
  min-width: 0;
}

.identity__name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 46rpx;
  color: #1f1f1f;
}

.identity__name--guest {
  text-decoration: underline;
}

.identity__uid {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: #373939;
}

.identity__cover-btn {
  width: 120rpx;
  height: 40rpx;
  line-height: 37rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 500;
  color: #1f1f1f;
  border: 1.5rpx solid #ffffff;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.32);
}

.identity__cover-btn--pressed {
  opacity: 0.7;
}

.bio {
  font-size: 24rpx;
  line-height: 31rpx;
  color: #373838;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 22rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: #404747;
}

.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat__num {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 46rpx;
  color: #1f1f1f;
}

.stat__label {
  font-size: 20rpx;
  line-height: 26rpx;
  color: #373838;
}

.vip {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin: 0 24rpx 12rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  border-radius: 32rpx;
  background: #66c4b4;
}

.vip--pressed {
  opacity: 0.88;
}

.vip__crown {
  flex-shrink: 0;
  width: 48rpx;
  height: 40rpx;
}

.vip__copy {
  flex: 1;
  min-width: 0;
}

.vip__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #1f1f1f;
}

.vip__sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  color: #475252;
}

.vip__cta {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background: #141414;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: #ffffff;
}

.body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 16rpx 32rpx 32rpx;
}

.block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.block__head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.block__title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 39rpx;
  color: #1c1f21;
}

.block__chip {
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(131, 212, 20, 0.18);
  font-size: 22rpx;
  font-weight: 500;
  color: #386b14;
}

.radar-card {
  padding: 12rpx 12rpx 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.radar {
  position: relative;
  height: 380rpx;
}

.radar__canvas {
  width: 100%;
  height: 380rpx;
}

.radar-label {
  position: absolute;
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  font-weight: 500;
  color: #1c1f21;
  background: #ffffff;
  padding: 0 4rpx;
}

.radar-label__num {
  font-size: 20rpx;
  font-weight: 700;
  color: #47850f;
}

.radar-label--n {
  left: 50%;
  top: 8rpx;
  align-items: center;
  transform: translateX(-50%);
}

.radar-label--ne {
  right: 12rpx;
  top: 86rpx;
}

.radar-label--se {
  right: 12rpx;
  bottom: 86rpx;
}

.radar-label--s {
  left: 50%;
  bottom: 8rpx;
  align-items: center;
  transform: translateX(-50%);
}

.radar-label--sw {
  left: 12rpx;
  bottom: 86rpx;
  align-items: flex-end;
}

.radar-label--nw {
  left: 12rpx;
  top: 86rpx;
  align-items: flex-end;
}

.radar-card__hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: #6b7a73;
}

.career {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.career-row {
  display: flex;
  gap: 10rpx;
}

.career-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.career-card--wide {
  width: 100%;
}

.career-card--pressed {
  opacity: 0.82;
}

.career-card__head {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.career-card__icon {
  width: 56rpx;
  height: 56rpx;
}

.career-card__name {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #1c1f21;
}

.career-card__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 29rpx;
  color: #787e6c;
}

.career-card__link {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 29rpx;
  color: #508c10;
}

.services {
  display: flex;
  gap: 10rpx;
}

.service {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  height: 139rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.service--pressed {
  opacity: 0.82;
}

.service__icon {
  width: 64rpx;
  height: 64rpx;
}

.service__icon--flip {
  transform: scaleX(-1);
}

.service__label {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 31rpx;
  color: #1c1f21;
}

.share-row {
  position: relative;
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 4rpx;
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 24rpx;
  color: #1c1f21;
}

.share-row__icon {
  width: 40rpx;
  height: 40rpx;
}

.share-row__hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

.share-row__hit::after {
  border: none;
}

.share-row--pressed {
  opacity: 0.82;
}

.tabbar-spacer {
  height: calc(153rpx + env(safe-area-inset-bottom));
}

/* ---------- 更换背景抽屉 401:359 ---------- */

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
}

.sheet__dim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.32);
}

.sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 0 calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
}

.sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto;
  border-radius: 4rpx;
  background: #d8d8d4;
}

.sheet__title {
  padding: 16rpx 32rpx 0;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 49rpx;
  color: #1c1f21;
}

.sheet__sub {
  padding: 8rpx 32rpx 0;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #737a76;
}

.sheet__label {
  padding: 20rpx 32rpx 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 35rpx;
  color: #1c1f21;
}

.swatches {
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx;
}

.swatch {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  font-size: 20rpx;
  font-weight: 500;
  color: #737a76;
}

.swatch--on {
  font-weight: 700;
  color: #1c1f21;
}

.swatch__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.swatch--on .swatch__dot {
  border-color: #83d414;
}

.swatch__fill {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.swatch__dot--photo {
  background: #ffffff;
}

.covers {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 32rpx;
}

.cover-pick {
  width: 162.5rpx;
  height: 110rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.cover-pick__img {
  width: 100%;
  height: 100%;
}

.cover-pick--on {
  box-shadow: 0 0 0 4rpx #83d414;
}

.cover-pick--album {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7faf7;
  border: 2rpx solid #d8d8d4;
  font-size: 22rpx;
  color: #737a76;
}

.sheet__done {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 686rpx;
  height: 80rpx;
  margin: 28rpx auto 0;
  border-radius: 24rpx;
  background: #83d414;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 41rpx;
  color: #1c1f21;
}
