/**
 * ============================================================================
 * 我的资料页样式 —— 视觉刷新草稿 V5
 * ============================================================================
 * 数值来自 Figma node 389:359。设计稿 1px = 1rpx。
 *
 * 【和旧版的差别】
 * 旧绿波浪头 + 金圈头像已经删掉。吸顶返回用 page-nav mint + occupy，
 * 页面自己是薄荷渐变底，白卡片圆角 28。头像是 140 的圆图，设计里没有金框。
 *
 * 想改选中胶囊颜色 → 改 .pill--on 的 background / border-color
 * 想改保存按钮     → 改 .save 的 background
 */

.edit {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: var(--header-gradient-down);
}

.avatar-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
  padding: 8rpx 0 12rpx;
}

.avatar-block__frame {
  width: 140rpx;
  height: 140rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #ffffff;
}

/**
 * 外圈裁圆，图用 aspectFit 完整放进圆里。
 * 不要 aspectFill：相册竖图会被切掉头。
 */
.avatar-block__photo {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-block__hint {
  font-size: 22rpx;
  line-height: 26rpx;
  color: #738078;
}

.card {
  margin: 0 32rpx 20rpx;
  padding: 24rpx 24rpx 8rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
}

.card__title {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
  color: #1c1f21;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e5ebe5;
}

.row--last {
  border-bottom: none;
}

.row--readonly {
  padding: 22rpx 0;
}

.row__label {
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 34rpx;
  color: #738078;
}

.row__right {
  display: flex;
  gap: 8rpx;
  align-items: center;
  min-width: 0;
  margin-left: 16rpx;
}

.row__value {
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 34rpx;
  color: #1c1f21;
  text-align: right;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row__value--placeholder {
  font-weight: 500;
  color: #738078;
}

.row__arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 40rpx;
  color: #738078;
}

.pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: flex-end;
}

.pill {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border: 1rpx solid #e5ebe5;
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  color: #738078;
}

.pill--on {
  border-color: var(--accent);
  background: var(--accent);
  color: #1c1f21;
}

.save {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 0 32rpx;
  border-radius: 16rpx;
  background: var(--accent);
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1f21;
}

.footnote {
  margin-top: 16rpx;
  padding: 0 32rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #738078;
  text-align: center;
}
